<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- Updated for Java 21 and MyBatis 3.5.15+ compatibility -->
<mapper namespace="org.sonatype.nexus.internal.security.secrets.SecretsDAO">

  <!-- Updated timestamp handling for PostgreSQL 42.7.2+ compatibility -->
  <insert id="createSchema">
    CREATE TABLE IF NOT EXISTS secrets (
      id              INT GENERATED BY DEFAULT AS IDENTITY,
      purpose         VARCHAR NOT NULL,
      key_id          VARCHAR,
      secret          VARCHAR NOT NULL,
      user_id         VARCHAR,
      created         TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,
      last_updated    TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT CURRENT_TIMESTAMP,

      CONSTRAINT pk_secrets_id PRIMARY KEY (id)
    );

    CREATE INDEX IF NOT EXISTS idx_secrets_key_id ON secrets (key_id);
  </insert>

  <!-- Added transaction context preservation for cryptographic operations -->
  <select id="read" resultType="org.sonatype.nexus.crypto.secrets.SecretData" flushCache="true">
    SELECT *
      FROM secrets
     WHERE id = #{id};
  </select>

  <!-- Optimized for BouncyCastle 1.78.1 compatibility -->
  <insert id="create" useGeneratedKeys="true" keyProperty="secretData.id" flushCache="true">
    INSERT INTO secrets (purpose, key_id, secret, user_id)
    VALUES (#{secretData.purpose}, #{secretData.keyId}, #{secretData.secret}, #{secretData.userId});
  </insert>

  <!-- Added transaction context preservation for cryptographic operations -->
  <delete id="delete" flushCache="true">
    DELETE
      FROM secrets
     WHERE id = #{id};
  </delete>

  <!-- Optimized for BouncyCastle 1.78.1 compatibility -->
  <update id="update" flushCache="true">
    UPDATE secrets
    SET secret = #{secret},
        key_id = #{keyId},
        last_updated = CURRENT_TIMESTAMP
    WHERE id = #{id}
      AND secret = #{oldSecret}
  </update>

  <!-- Optimized for Virtual Thread execution efficiency -->
  <select id="existWithDifferentKeyId" resultType="boolean" flushCache="true">
    SELECT EXISTS(
      SELECT 1 FROM secrets 
      WHERE key_id &lt;&gt; #{keyId} OR key_id IS NULL
      LIMIT 1
    );
  </select>

  <!-- Optimized for Virtual Thread execution efficiency with improved query performance -->
  <select id="fetchWithDifferentKeyId" resultType="org.sonatype.nexus.crypto.secrets.SecretData" flushCache="true">
    SELECT id, purpose, key_id, secret, user_id, created, last_updated
      FROM secrets
      WHERE key_id &lt;&gt; #{keyId}
        OR key_id IS NULL
      ORDER BY id
      LIMIT #{limit};
  </select>
</mapper>