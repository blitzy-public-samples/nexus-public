    {
      "description": "Simple type pattern matching",
      "input": {
        "type": "hosted",
        "name": "test-repo"
      },
      "expectedPattern": "case Repository r when r.type.equals(\"hosted\") ->"
    },
    {
      "description": "Null handling in pattern matching",
      "input": {
        "type": null,
        "name": "null-type-repo"
      },
      "expectedPattern": "case null ->"
    },
    {
      "description": "Complex nested pattern matching",
      "input": {
        "type": "proxy",
        "attributes": {
          "proxy": {
            "remoteUrl": "https://example.com/repo",
            "authentication": {
              "type": "username",
              "username": "user"
            }
          }
        }
      },
      "expectedPattern": "case Repository r when r.type.equals(\"proxy\") && r.attributes.proxy.authentication.type.equals(\"username\") ->"
    },
    {
      "description": "Pattern matching with multiple conditions",
      "input": {
        "type": "group",
        "attributes": {
          "group": {
            "memberNames": ["repo1", "repo2", "repo3"]
          }
        }
      },
      "expectedPattern": "case Repository r when r.type.equals(\"group\") && r.attributes.group.memberNames.size() > 2 ->"
