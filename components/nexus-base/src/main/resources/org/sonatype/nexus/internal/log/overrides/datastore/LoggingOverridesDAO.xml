<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.sonatype.nexus.internal.log.overrides.datastore.LoggingOverridesDAO">

  <!-- @VirtualThread compatible - Safe for concurrent execution with virtual threads -->
  <insert id="createSchema">
    CREATE TABLE IF NOT EXISTS logging_overrides (
      id INTEGER AUTO_INCREMENT,
      name VARCHAR(256) NOT NULL,
      level VARCHAR(256) NOT NULL,

      CONSTRAINT pk_logging_overrides_id PRIMARY KEY (id)
      );

    CREATE UNIQUE INDEX IF NOT EXISTS uk_name ON logging_overrides (name);
  </insert>

  <!-- @VirtualThread compatible - Safe for concurrent execution with virtual threads -->
  <insert id="createRecord" parameterType="LoggingOverridesData">
    INSERT INTO logging_overrides (name, level)
    VALUES (#{name}, #{level});
  </insert>

  <!-- @VirtualThread compatible - Optimized for concurrent access patterns with virtual threads -->
  <select id="readRecords" resultType="org.sonatype.nexus.internal.log.overrides.datastore.LoggingOverridesData" fetchSize="100">
    SELECT id, name, level FROM logging_overrides
    <if test="continuationToken != null">WHERE id > #{continuationToken}</if>
    ORDER BY id
  </select>

  <!-- @VirtualThread compatible - Safe for concurrent execution with virtual threads -->
  <update id="updateRecord" parameterType="LoggingOverridesData">
    UPDATE logging_overrides
    SET level = #{level}
    WHERE name = #{name}
  </update>

  <!-- @VirtualThread compatible - Safe for concurrent execution with virtual threads -->
  <delete id="deleteRecord">
    DELETE FROM logging_overrides
    WHERE name = #{name};
  </delete>

  <!-- @VirtualThread compatible - Safe for concurrent execution with virtual threads -->
  <delete id="deleteAllRecords">
    DELETE FROM logging_overrides
  </delete>
  
  <!-- @VirtualThread compatible - Batch processing for efficient transaction handling -->
  <insert id="batchCreateRecords" parameterType="java.util.List">
    INSERT INTO logging_overrides (name, level)
    VALUES 
    <foreach collection="list" item="item" separator=",">
      (#{item.name}, #{item.level})
    </foreach>
  </insert>

  <!-- @VirtualThread compatible - Batch processing for efficient transaction handling -->
  <update id="batchUpdateRecords" parameterType="java.util.List">
    <foreach collection="list" item="item" separator=";">
      UPDATE logging_overrides
      SET level = #{item.level}
      WHERE name = #{item.name}
    </foreach>
  </update>

</mapper>