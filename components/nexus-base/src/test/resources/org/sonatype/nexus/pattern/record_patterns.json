{
  "repository": {
    "name": "maven-central",
    "type": "proxy",
    "format": "maven2",
    "online": true,
    "attributes": {
      "proxy": {
        "remoteUrl": "https://repo1.maven.org/maven2/",
        "contentMaxAge": 1440,
        "metadataMaxAge": 1440
      },
      "httpclient": {
        "blocked": false,
        "autoBlock": true,
        "connection": {
          "retries": 3,
          "timeout": 60,
          "enableCircularRedirects": false,
          "enableCookies": false
        },
        "authentication": null
      },
      "storage": {
        "blobStoreName": "default",
        "strictContentTypeValidation": true
      },
      "cleanup": {
        "policyName": "cleanup-weekly"
      }
    }
  },
  "repositoryGroup": {
    "name": "maven-public",
    "type": "group",
    "format": "maven2",
    "online": true,
    "members": [
      "maven-central",
      "maven-releases",
      "maven-snapshots"
    ],
    "attributes": {
      "storage": {
        "blobStoreName": "default",
        "strictContentTypeValidation": true
      }
    }
  },
  "blobStore": {
    "name": "default",
    "type": "file",
    "attributes": {
      "file": {
        "path": "data/blobs/default",
        "volumeId": "default-volume"
      },
      "metrics": {
        "totalSize": 1073741824,
        "availableSpace": 536870912,
        "blobCount": 1024
      }
    }
  },
  "s3BlobStore": {
    "name": "s3-store",
    "type": "s3",
    "attributes": {
      "s3": {
        "region": "us-west-2",
        "bucket": "nexus-blobs",
        "prefix": "data",
        "expiration": 3,
        "encryption": {
          "type": "s3ManagedEncryption",
          "keyId": null
        }
      },
      "metrics": {
        "totalSize": 2147483648,
        "availableSpace": 1073741824,
        "blobCount": 2048
      }
    }
  },
