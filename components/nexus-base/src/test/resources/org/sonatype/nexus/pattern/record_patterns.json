  "nestedRecords": {
    "user": {
      "username": "admin",
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@example.com",
      "roles": [
        {
          "id": "nx-admin",
          "name": "Administrator",
          "description": "Administrator role",
          "privileges": [
            {
              "id": "nx-all",
              "name": "All permissions",
              "description": "All permissions",
              "type": "application"
            }
          ]
        }
      ]
    },
    "task": {
      "id": "cleanup-task",
      "name": "Repository Cleanup",
      "type": "repository.cleanup",
      "schedule": {
        "type": "cron",
        "cronExpression": "0 0 1 * * ?",
        "startTime": "2023-01-01T00:00:00Z",
        "timeZone": "UTC"
      },
      "properties": {
        "repositoryName": "maven-central",
        "minimumRetained": 3,
        "removeIfReleased": true
      }
    }
  },
  "recordArrays": {
    "repositories": [
      {
        "name": "maven-releases",
        "type": "hosted",
        "format": "maven2",
        "online": true,
        "attributes": {
          "storage": {
            "blobStoreName": "default",
            "strictContentTypeValidation": true,
            "writePolicy": "ALLOW_ONCE"
          }
        }
      },
      {
        "name": "maven-snapshots",
        "type": "hosted",
        "format": "maven2",
        "online": true,
        "attributes": {
          "storage": {
            "blobStoreName": "default",
            "strictContentTypeValidation": true,
            "writePolicy": "ALLOW"
          }
        }
      }
    ],
    "blobStores": [
      {
        "name": "default",
        "type": "file",
        "attributes": {
          "file": {
            "path": "data/blobs/default",
            "volumeId": "default-volume"
          }
        }
      },
      {
        "name": "backup",
        "type": "file",
        "attributes": {
          "file": {
            "path": "data/blobs/backup",
            "volumeId": "backup-volume"
          }
        }
      }
    ]
  },
