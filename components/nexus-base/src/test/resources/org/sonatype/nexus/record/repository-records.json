  "cleanupPolicies": [
    {
      "name": "cleanup-releases",
      "format": "maven2",
      "notes": "Cleanup policy for release repositories",
      "criteria": {
        "lastBlobUpdated": 365,
        "lastDownloaded": 180,
        "regex": ".*-SNAPSHOT.*",
        "assetRegex": ".*\\.(jar|pom|war|ear)$"
      }
    },
    {
      "name": "cleanup-snapshots",
      "format": "maven2",
      "notes": "Cleanup policy for snapshot repositories",
      "criteria": {
        "lastBlobUpdated": 30,
        "lastDownloaded": 15
      }
    }
  ],
  "tasks": [
    {
      "id": "t1",
      "name": "Admin - Compact blob store",
      "type": "blobstore.compact",
      "enabled": true,
      "schedule": {
        "type": "cron",
        "cronExpression": "0 0 2 * * ?"
      },
      "properties": {
        "blobstoreName": "default"
      },
      "lastRun": "2023-11-20T02:00:00.000Z",
      "nextRun": "2023-11-21T02:00:00.000Z",
      "status": "WAITING"
    },
    {
      "id": "t2",
      "name": "Admin - Cleanup repositories using cleanup policies",
      "type": "repository.cleanup",
      "enabled": true,
      "schedule": {
        "type": "cron",
        "cronExpression": "0 0 1 * * ?"
      },
      "properties": {
        "repositoryName": "*"
      },
      "lastRun": "2023-11-20T01:00:00.000Z",
      "nextRun": "2023-11-21T01:00:00.000Z",
      "status": "WAITING"
    }
  ],
  "routingRules": [
    {
      "name": "external-dependencies",
      "description": "Route for external dependencies",
      "mode": "BLOCK",
      "matchers": [
        "^/org/apache/.*",
        "^/commons-.*",
        "^/log4j/.*"
      ]
    },
    {
      "name": "internal-only",
      "description": "Route for internal artifacts",
      "mode": "ALLOW",
      "matchers": [
        "^/com/example/.*",
        "^/org/example/.*"
      ]
    }
  ],
  "selectors": [
    {
      "name": "all-maven-releases",
      "type": "csel",
      "expression": "format == \"maven2\" and path =~ \"^/org/sonatype/.*\" and not path =~ \".*-SNAPSHOT.*\"",
      "description": "All Maven release artifacts"
    },
    {
      "name": "raw-executables",
      "type": "csel",
      "expression": "format == \"raw\" and path =~ \".*\\.(sh|bat|exe|cmd|ps1)$\"",
      "description": "Executable files in raw repositories"
    }
  ]
}