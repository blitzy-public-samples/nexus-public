            "type": "DB_TRANSACTION",
            "weight": 0.4,
            "concurrentOperations": 200
          }
        ],
        "totalOperations": 5000,
        "expectedDurationMs": 10000,
        "metadata": {
          "virtualThreadBenefit": "HIGH",
          "platformThreadEquivalent": 150
        }
      }
    ],
    "virtualThreadSpecificTests": [
      {
        "id": "massive_concurrent_connections",
        "description": "Test with extremely high number of concurrent connections",
        "operationType": "HTTP_GET",
        "concurrentOperations": 10000,
        "expectedDurationMs": 5000,
        "metadata": {
          "virtualThreadBenefit": "EXTREME",
          "notes": "This test is designed to validate the scalability benefits of Virtual Threads with a number of concurrent operations that would be impractical with platform threads"
        }
      },
      {
        "id": "long_running_io_operations",
        "description": "Test with long-running I/O operations that would tie up platform threads",
        "operationType": "MIXED",
        "operations": [
          {
            "type": "HTTP_DOWNLOAD",
            "count": 100,
            "durationMs": 10000
          },
          {
            "type": "DB_QUERY",
            "count": 500,
            "durationMs": 5000
          }
        ],
        "concurrentOperations": 1000,
        "expectedDurationMs": 15000,
        "metadata": {
          "virtualThreadBenefit": "EXTREME",
          "notes": "This test validates that Virtual Threads can efficiently handle long-running I/O operations without exhausting system resources"
        }
      },
      {
        "id": "pinning_test",
        "description": "Test to validate behavior when Virtual Threads are pinned to carrier threads",
        "operationType": "SYNCHRONIZED_IO",
        "concurrentOperations": 100,
        "expectedDurationMs": 2000,
        "metadata": {
          "virtualThreadBenefit": "LOW",
          "notes": "This test intentionally creates a scenario where Virtual Threads are pinned to carrier threads to validate the performance impact"
        }
      }
    ],
