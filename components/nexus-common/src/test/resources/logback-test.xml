<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- 
    Java 21 Virtual Thread Support:
    - Enhanced thread pattern to properly display virtual thread information
    - Added optional diagnostic logging for virtual threads (disabled by default)
    - Thread pattern will show carrier thread information for virtual threads when enabled
  -->

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <encoder>
      <!-- Enhanced pattern to better display virtual thread information -->
      <pattern>%date %level [%thread%X{DC}] %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Optional Virtual Thread diagnostic appender with more detailed information -->
  <appender name="VIRTUAL_THREAD_DIAGNOSTICS" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.out</target>
    <encoder>
      <!-- Detailed pattern showing carrier thread information for virtual threads -->
      <pattern>%date %level [VT:%thread@%X{carrierThread:-unknown}%X{DC}] %logger - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Main logger configuration -->
  <logger name="org.sonatype.nexus.common" level="DEBUG"/>

  <!-- Virtual Thread diagnostic loggers (disabled by default) -->
  <!-- Enable these loggers to get more detailed information about virtual threads -->
  <logger name="jdk.internal.vm.Continuation" level="OFF" />
  <logger name="java.lang.VirtualThread" level="OFF" />
  <logger name="org.sonatype.nexus.virtualthread" level="OFF">
    <appender-ref ref="VIRTUAL_THREAD_DIAGNOSTICS"/>
  </logger>

  <root level="${test.log.level:-INFO}">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>