  "virtualThreadTestCases": [
    {
      "name": "performance",
      "description": "Tests performance differences between platform threads and virtual threads",
      "concurrencyLevels": [10, 50, 100, 500, 1000, 5000],
      "operations": ["read", "write", "delete"],
      "expectedResults": {
        "throughputImprovement": 0.3,
        "latencyReduction": 0.25,
        "resourceUtilization": 0.5
      }
    },
    {
      "name": "transaction",
      "description": "Tests transaction context preservation across virtual thread handoffs",
      "scenarios": [
        {
          "name": "commit",
          "steps": ["start", "modify", "commit"],
          "expectedResult": "success"
        },
        {
          "name": "rollback",
          "steps": ["start", "modify", "error", "rollback"],
          "expectedResult": "success"
        },
        {
          "name": "nested",
          "steps": ["start", "startNested", "modify", "commitNested", "commit"],
          "expectedResult": "success"
        }
      ]
    },
    {
      "name": "jakarta",
      "description": "Tests Jakarta Transaction API integration with virtual threads",
      "scenarios": [
        {
          "name": "annotated",
          "annotation": "@Transactional",
          "expectedResult": "success"
        },
        {
          "name": "programmatic",
          "api": "TransactionManager",
          "expectedResult": "success"
        },
        {
          "name": "exception",
          "annotation": "@Transactional",
          "throwException": true,
          "expectedResult": "rollback"
        }
      ]
    }
  ],
