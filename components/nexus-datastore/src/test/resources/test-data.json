  "virtual_thread_test_scenarios": [
    {
      "name": "concurrent_read_operations",
      "description": "Test concurrent read operations with Virtual Threads",
      "thread_count": 1000,
      "operations": [
        {
          "type": "read",
          "entity": "component",
          "repository": "maven-central",
          "format": "maven2",
          "query": {
            "group": "org.sonatype.nexus",
            "name": "nexus-common",
            "version": "3.45.0"
          }
        }
      ]
    },
    {
      "name": "concurrent_write_operations",
      "description": "Test concurrent write operations with Virtual Threads",
      "thread_count": 100,
      "operations": [
        {
          "type": "write",
          "entity": "component",
          "repository": "maven-snapshots",
          "format": "maven2",
          "data": {
            "group": "org.sonatype.nexus.test",
            "name": "test-component-${thread_id}",
            "version": "1.0.0-SNAPSHOT"
          }
        }
      ]
    },
    {
      "name": "mixed_read_write_operations",
