  "pinningTestCases": [
    {
      "name": "synchronized_block_test",
      "description": "Test case to detect pinning with synchronized blocks",
      "codeSnippet": "synchronized(lock) { performBlockingOperation(); }",
      "expectedBehavior": "Thread pinning detected, carrier thread blocked",
      "mitigation": "Replace synchronized with ReentrantLock",
      "detectionMethod": "-Djdk.tracePinnedThreads=full",
      "impact": "Reduces scalability by preventing carrier thread reuse"
    },
    {
      "name": "native_method_test",
      "description": "Test case to detect pinning with native methods",
      "codeSnippet": "nativeMethod();",
      "expectedBehavior": "Thread pinning detected, carrier thread blocked",
      "mitigation": "Minimize use of native methods with virtual threads",
      "detectionMethod": "JFR event jdk.VirtualThreadPinned",
      "impact": "Blocks carrier thread during entire native method execution"
    },
    {
      "name": "foreign_function_test",
      "description": "Test case to detect pinning with foreign function calls",
      "codeSnippet": "MemorySegment.allocateNative(100); // Foreign memory access",
      "expectedBehavior": "Thread pinning detected, carrier thread blocked",
      "mitigation": "Minimize use of foreign function calls with virtual threads",
      "detectionMethod": "-Djdk.tracePinnedThreads=full",
      "impact": "Blocks carrier thread during foreign function execution"
    },
    {
      "name": "database_transaction_test",
      "description": "Test case to detect pinning with database transactions in synchronized blocks",
      "codeSnippet": "synchronized(dbLock) { connection.executeQuery(sql); }",
      "expectedBehavior": "Thread pinning detected during database I/O operations",
      "mitigation": "Use ReentrantLock instead of synchronized for database operations",
      "detectionMethod": "JFR event jdk.VirtualThreadPinned with threshold=20ms",
      "impact": "Severely limits database connection concurrency"
    }
  ],
  "dataStoreSpecificTests": [
    {
      "name": "blob_store_concurrent_access",
      "description": "Test concurrent access to blob store with virtual threads",
      "configuration": {
        "threadCount": 5000,
