  <!-- Test CDATA section handling -->
  <description><![CDATA[
    This is a test artifact for verifying XML processing with Java 21 Virtual Threads.
    It contains various XML features that might trigger different parsing behaviors:
    - Namespace declarations
    - Deeply nested elements
    - Elements with multiple attributes
    - Mixed content (text and elements)
    - CDATA sections
    - Special characters: & < > " '
  ]]></description>
  
  <!-- Test mixed content -->
  <documentation>
    See the <a href="https://docs.oracle.com/en/java/javase/21/core/virtual-threads.html">Virtual Threads documentation</a>
    for more information about Java 21 Virtual Threads.
  </documentation>
  
  <!-- Test attributes with special characters -->
  <properties>
    <property name="test:with:colons" value="Value with spaces"/>
    <property name="special&chars" value="Value with &amp; and &lt; and &gt;"/>
    <property name="unicode" value="こんにちは世界"/>
    <property name="long-value" value="This is a very long property value that might trigger different buffer handling in XML parsers. It's important to test with various content lengths to ensure that the parser handles all cases correctly with Virtual Threads. Thread pinning can sometimes occur with certain parsing operations, especially when dealing with large buffers or complex parsing logic."/>
  </properties>
  
  <!-- Test deeply nested structure -->
  <buildEnvironment>
    <jdk>
      <version>21</version>
      <vendor>Oracle</vendor>
      <features>
        <feature>
          <name>Virtual Threads</name>
          <description>
            <summary>Lightweight threads that dramatically reduce the effort of writing, maintaining, and observing high-throughput concurrent applications</summary>
            <details>
              <implementation>
                <class>java.lang.Thread</class>
                <factory>java.util.concurrent.Executors.newVirtualThreadPerTaskExecutor()</factory>
                <benefits>
                  <benefit>Reduced memory footprint</benefit>
                  <benefit>Improved throughput for I/O-bound applications</benefit>
                  <benefit>Simplified concurrency model</benefit>
                  <benefit>Better CPU utilization</benefit>
                </benefits>
              </implementation>
            </details>
          </description>
        </feature>
        <feature>
          <name>Pattern Matching</name>
          <description>Type-based pattern matching for switch expressions</description>
        </feature>
      </features>
    </jdk>
    <os name="Linux" version="5.15.0" arch="x86_64"/>
  </buildEnvironment>
  
