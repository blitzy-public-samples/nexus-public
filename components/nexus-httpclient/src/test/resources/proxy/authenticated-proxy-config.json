{
  "http": {
    "proxy": {
      "host": "proxy.example.com",
      "port": 8080,
      "enabled": true,
      "nonProxyHosts": ["localhost", "127.0.0.1", "*.internal.example.com"],
      "authentication": {
        "basic": {
          "username": "proxyuser",
          "password": "proxypass",
          "preemptive": true
        },
        "ntlm": {
          "username": "ntlmuser",
          "password": "ntlmpass",
          "domain": "EXAMPLE",
          "host": "ntlmhost"
        },
        "digest": {
          "username": "digestuser",
          "password": "digestpass",
          "validateServer": true
        }
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConnections": 1000,
        "connectionTimeout": 5000,
        "readTimeout": 30000,
        "preventThreadPinning": true
      }
    }
  },
  "https": {
    "proxy": {
      "host": "secure-proxy.example.com",
      "port": 8443,
      "enabled": true,
      "nonProxyHosts": ["localhost", "127.0.0.1", "*.internal.example.com"],
      "authentication": {
        "basic": {
          "username": "secureuser",
          "password": "securepass",
          "preemptive": true
        },
        "ntlm": {
          "username": "securentlmuser",
          "password": "securentlmpass",
          "domain": "SECUREEXAMPLE",
          "host": "securentlmhost"
        },
        "digest": {
          "username": "securedigestuser",
          "password": "securedigestpass",
          "validateServer": true
        }
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConnections": 1000,
        "connectionTimeout": 5000,
        "readTimeout": 30000,
        "preventThreadPinning": true
      }
    }
  },
  "authenticationSchemes": {
    "basic": {
      "enabled": true,
      "priority": 1,
      "preemptive": true
    },
    "ntlm": {
      "enabled": true,
      "priority": 2,
      "domain": "EXAMPLE",
      "host": "ntlmhost",
      "username": "ntlmuser",
      "password": "ntlmpass"
    },
    "digest": {
      "enabled": true,
      "priority": 3,
      "username": "digestuser",
      "password": "digestpass",
      "validateServer": true,
      "cnonceRepeat": 5
    }
  },
  "virtualThreadTestConfig": {
    "concurrentConnections": 5000,
    "requestsPerConnection": 10,
    "testDuration": 60000,
    "authenticationSequence": ["basic", "ntlm", "digest"],
    "monitorThreadPinning": true,
    "validateAuthenticationFlow": true,
    "java21Features": {
      "useStructuredConcurrency": true,
      "useVirtualThreadPerTaskExecutor": true,
      "threadDumpAnalysis": true,
      "monitorCarrierThreadUtilization": true
    }
  }
}