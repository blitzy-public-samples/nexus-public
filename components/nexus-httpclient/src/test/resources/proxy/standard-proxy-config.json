{
  "http": {
    "enabled": true,
    "host": "http-proxy.example.com",
    "port": 8080,
    "authentication": {
      "enabled": false,
      "username": "",
      "password": "",
      "ntlmHost": "",
      "ntlmDomain": ""
    }
  },
  "https": {
    "enabled": true,
    "host": "https-proxy.example.com",
    "port": 8443,
    "authentication": {
      "enabled": false,
      "username": "",
      "password": "",
      "ntlmHost": "",
      "ntlmDomain": ""
    }
  },
  "nonProxyHosts": [
    "localhost",
    "127.0.0.1",
    "::1",
    "*.internal.example.com",
    "10.*",
    "192.168.*"
  ],
  "connection": {
    "timeout": 20000,
    "retries": 3,
    "userAgentSuffix": "Nexus/Java21-VirtualThread",
    "enableCircularRedirects": true,
    "enableCookies": true,
    "useTrustStore": false
  },
  "virtualThreads": {
    "enabled": true,
    "maxConcurrentConnections": 10000,
    "preventThreadPinning": true,
    "adaptiveTimeout": true,
    "timeoutMultiplier": 0.8
  },
  "retry": {
    "enabled": true,
    "initialDelayMs": 50,
    "maxDelayMs": 10000,
    "backoffFactor": 2.0,
    "maxRetries": 3,
    "retryOnTimeout": true
  }
}