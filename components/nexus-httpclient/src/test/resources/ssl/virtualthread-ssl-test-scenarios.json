{
  "description": "HTTP Client SSL Test Scenarios with Virtual Threads for Java 21",
  "version": "1.0",
  "lastUpdated": "2025-05-23",
  "scenarios": [
    {
      "id": "tls13-standard-auth",
      "name": "TLS 1.3 Standard Authentication",
      "description": "Tests HTTP client with TLS 1.3 using standard server authentication",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 200,
        "maxConnectionsPerRoute": 50,
        "timeToLive": 30000,
        "validateAfterInactivity": 5000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 1000,
        "pinningDetection": true
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyHostname": true,
        "verifyCertificateChain": true
      }
    },
    {
      "id": "tls13-mutual-auth",
      "name": "TLS 1.3 Mutual Authentication",
      "description": "Tests HTTP client with TLS 1.3 using mutual (two-way) authentication",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256"
      ],
      "authType": "mutual",
      "clientCertConfig": {
        "keyStoreType": "PKCS12",
        "keyStorePasswordEnvVar": "CLIENT_KEYSTORE_PASSWORD",
        "keyPasswordEnvVar": "CLIENT_KEY_PASSWORD"
      },
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 200,
        "maxConnectionsPerRoute": 50,
        "timeToLive": 30000,
        "validateAfterInactivity": 5000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 1000,
        "pinningDetection": true
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyHostname": true,
        "verifyCertificateChain": true
      }
    },
    {
      "id": "tls12-standard-auth",
      "name": "TLS 1.2 Standard Authentication",
      "description": "Tests HTTP client with TLS 1.2 using standard server authentication",
      "tlsProtocol": "TLSv1.2",
      "cipherSuites": [
        "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 200,
        "maxConnectionsPerRoute": 50,
        "timeToLive": 30000,
        "validateAfterInactivity": 5000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 1000,
        "pinningDetection": true
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyHostname": true,
        "verifyCertificateChain": true
      }
    },
    {
      "id": "tls12-mutual-auth",
      "name": "TLS 1.2 Mutual Authentication",
      "description": "Tests HTTP client with TLS 1.2 using mutual (two-way) authentication",
      "tlsProtocol": "TLSv1.2",
      "cipherSuites": [
        "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
        "TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
      ],
      "authType": "mutual",
      "clientCertConfig": {
        "keyStoreType": "PKCS12",
        "keyStorePasswordEnvVar": "CLIENT_KEYSTORE_PASSWORD",
        "keyPasswordEnvVar": "CLIENT_KEY_PASSWORD"
      },
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 200,
        "maxConnectionsPerRoute": 50,
        "timeToLive": 30000,
        "validateAfterInactivity": 5000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 1000,
        "pinningDetection": true
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyHostname": true,
        "verifyCertificateChain": true
      }
    },
    {
      "id": "tls13-high-concurrency",
      "name": "TLS 1.3 High Concurrency Test",
      "description": "Tests HTTP client with TLS 1.3 under high concurrency using Virtual Threads",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 500,
        "maxConnectionsPerRoute": 100,
        "timeToLive": 30000,
        "validateAfterInactivity": 5000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 10000,
        "pinningDetection": true,
        "schedulerParallelism": 16,
        "maxPoolSize": 256
      },
      "loadProfile": {
        "rampUpPeriodSeconds": 30,
        "steadyStatePeriodSeconds": 60,
        "requestsPerSecond": 1000
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "p95ResponseTimeMs": 350,
        "p99ResponseTimeMs": 450,
        "verifyHostname": true,
        "verifyCertificateChain": true,
        "maxErrorRate": 0.001
      }
    },
    {
      "id": "tls-connection-pool-reuse",
      "name": "TLS Connection Pool Reuse Test",
      "description": "Tests HTTP client connection pool reuse with TLS connections using Virtual Threads",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 100,
        "maxConnectionsPerRoute": 20,
        "timeToLive": 60000,
        "validateAfterInactivity": 10000,
        "evictIdleConnections": true,
        "idleTimeoutMs": 30000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 500,
        "pinningDetection": true
      },
      "testSequence": [
        {
          "phase": "initial",
          "requestCount": 100,
          "delayBetweenRequestsMs": 50
        },
        {
          "phase": "idle",
          "durationMs": 15000
        },
        {
          "phase": "reuse",
          "requestCount": 100,
          "delayBetweenRequestsMs": 50
        }
      ],
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyHostname": true,
        "verifyCertificateChain": true,
        "connectionMetrics": {
          "minConnectionReuse": 50,
          "maxNewConnectionsInReusePhase": 10
        }
      }
    },
    {
      "id": "tls-thread-pinning-detection",
      "name": "TLS Thread Pinning Detection Test",
      "description": "Tests HTTP client for thread pinning issues during TLS handshake with Virtual Threads",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 200,
        "maxConnectionsPerRoute": 50
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 1000,
        "pinningDetection": true,
        "pinningThresholdMs": 100,
        "tracePinnedThreads": "full",
        "captureStackTraces": true
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyHostname": true,
        "verifyCertificateChain": true,
        "threadPinningMetrics": {
          "maxPinnedThreadPercentage": 0.0,
          "maxPinningDurationMs": 0
        }
      }
    },
    {
      "id": "tls-handshake-timeout",
      "name": "TLS Handshake Timeout Test",
      "description": "Tests HTTP client behavior when TLS handshake times out with Virtual Threads",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 50,
        "maxConnectionsPerRoute": 10
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 100,
        "pinningDetection": true
      },
      "timeoutConfig": {
        "connectTimeoutMs": 1000,
        "socketTimeoutMs": 2000,
        "connectionRequestTimeoutMs": 1000,
        "handshakeTimeoutMs": 1500
      },
      "mockServerConfig": {
        "delayHandshakeMs": 2000
      },
      "validation": {
        "expectedExceptionType": "javax.net.ssl.SSLHandshakeException",
        "expectedExceptionMessage": "handshake timed out",
        "verifyThreadRelease": true,
        "maxResourceLeakage": 0
      }
    },
    {
      "id": "tls-cert-revocation",
      "name": "TLS Certificate Revocation Test",
      "description": "Tests HTTP client behavior with certificate revocation checking using Virtual Threads",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 50,
        "maxConnectionsPerRoute": 10
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 100,
        "pinningDetection": true
      },
      "certRevocationConfig": {
        "enabled": true,
        "ocspEnabled": true,
        "crlEnabled": true,
        "softFail": false
      },
      "mockServerConfig": {
        "scenarios": [
          {
            "name": "valid-cert",
            "revoked": false,
            "expectedResult": "success"
          },
          {
            "name": "revoked-cert",
            "revoked": true,
            "expectedResult": "failure"
          }
        ]
      },
      "validation": {
        "validCertScenario": {
          "expectedResponseCode": 200
        },
        "revokedCertScenario": {
          "expectedExceptionType": "javax.net.ssl.SSLHandshakeException",
          "expectedExceptionMessage": "certificate revoked"
        },
        "verifyThreadRelease": true
      }
    },
    {
      "id": "tls-protocol-negotiation",
      "name": "TLS Protocol Negotiation Test",
      "description": "Tests HTTP client TLS protocol negotiation with Virtual Threads",
      "tlsProtocols": ["TLSv1.3", "TLSv1.2"],
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_AES_128_GCM_SHA256",
        "TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384",
        "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 50,
        "maxConnectionsPerRoute": 10
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 100,
        "pinningDetection": true
      },
      "mockServerConfig": {
        "scenarios": [
          {
            "name": "tls13-only-server",
            "supportedProtocols": ["TLSv1.3"],
            "expectedNegotiatedProtocol": "TLSv1.3"
          },
          {
            "name": "tls12-only-server",
            "supportedProtocols": ["TLSv1.2"],
            "expectedNegotiatedProtocol": "TLSv1.2"
          },
          {
            "name": "tls12-and-tls13-server",
            "supportedProtocols": ["TLSv1.2", "TLSv1.3"],
            "expectedNegotiatedProtocol": "TLSv1.3"
          }
        ]
      },
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "verifyNegotiatedProtocol": true,
        "verifyThreadRelease": true
      }
    },
    {
      "id": "tls-session-resumption",
      "name": "TLS Session Resumption Test",
      "description": "Tests HTTP client TLS session resumption with Virtual Threads",
      "tlsProtocol": "TLSv1.3",
      "cipherSuites": [
        "TLS_AES_256_GCM_SHA384"
      ],
      "authType": "standard",
      "connectionPooling": {
        "enabled": true,
        "maxConnections": 50,
        "maxConnectionsPerRoute": 10,
        "timeToLive": 60000
      },
      "virtualThreadConfig": {
        "enabled": true,
        "maxConcurrentRequests": 100,
        "pinningDetection": true
      },
      "tlsSessionConfig": {
        "sessionCacheSize": 1000,
        "sessionTimeout": 3600
      },
      "testSequence": [
        {
          "phase": "initial",
          "requestCount": 10,
          "delayBetweenRequestsMs": 100
        },
        {
          "phase": "resumption",
          "requestCount": 10,
          "delayBetweenRequestsMs": 100
        }
      ],
      "validation": {
        "expectedResponseCode": 200,
        "maxResponseTimeMs": 500,
        "sessionResumptionMetrics": {
          "minResumedSessions": 8,
          "maxFullHandshakes": 2
        },
        "verifyThreadRelease": true
      }
    }
  ]
}