{
  "version": "1.0",
  "description": "Test scenarios for validating HTTP client functionality with Java 21 Virtual Threads",
  "scenarios": [
    {
      "id": "concurrent-connections",
      "name": "Massively Concurrent HTTP Client Connections",
      "description": "Validates the HTTP client's ability to handle a large number of concurrent connections using Virtual Threads",
      "testCases": [
        {
          "id": "basic-concurrent-get",
          "name": "Basic Concurrent GET Requests",
          "description": "Executes multiple concurrent GET requests to validate basic Virtual Thread functionality",
          "parameters": {
            "concurrentRequests": 1000,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 30
          }
        },
        {
          "id": "scaled-concurrent-get",
          "name": "Scaled Concurrent GET Requests",
          "description": "Tests scalability by executing an extremely high number of concurrent GET requests",
          "parameters": {
            "concurrentRequests": 10000,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60
          }
        },
        {
          "id": "mixed-http-methods",
          "name": "Mixed HTTP Methods Concurrently",
          "description": "Executes a mix of GET, POST, PUT, and DELETE requests concurrently",
          "parameters": {
            "concurrentRequests": 2000,
            "requestTypes": ["GET", "POST", "PUT", "DELETE"],
            "targetEndpoints": {
              "GET": "${test.server.url}/resources",
              "POST": "${test.server.url}/resources",
              "PUT": "${test.server.url}/resources/{id}",
              "DELETE": "${test.server.url}/resources/{id}"
            },
            "expectedStatusCodes": {
              "GET": 200,
              "POST": 201,
              "PUT": 200,
              "DELETE": 204
            },
            "timeoutSeconds": 45
          }
        },
        {
          "id": "concurrent-with-authentication",
          "name": "Concurrent Requests with Authentication",
          "description": "Tests concurrent requests that require authentication",
          "parameters": {
            "concurrentRequests": 500,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/protected-resource",
            "authType": "basic",
            "credentials": {
              "username": "${test.auth.username}",
              "password": "${test.auth.password}"
            },
            "expectedStatusCode": 200,
            "timeoutSeconds": 30
          }
        }
      ]
    },
    {
      "id": "io-bound-operations",
      "name": "I/O-Bound HTTP Operations",
      "description": "Validates the performance benefits of Virtual Threads for I/O-bound HTTP operations",
      "testCases": [
        {
          "id": "large-file-download",
          "name": "Large File Download",
          "description": "Tests downloading large files concurrently to validate I/O performance with Virtual Threads",
          "parameters": {
            "concurrentRequests": 50,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/large-file",
            "fileSizeMB": 100,
            "expectedStatusCode": 200,
            "timeoutSeconds": 120,
            "validateChecksum": true
          }
        },
        {
          "id": "large-file-upload",
          "name": "Large File Upload",
          "description": "Tests uploading large files concurrently to validate I/O performance with Virtual Threads",
          "parameters": {
            "concurrentRequests": 20,
            "requestType": "POST",
            "targetEndpoint": "${test.server.url}/upload",
            "fileSizeMB": 50,
            "expectedStatusCode": 201,
            "timeoutSeconds": 180,
            "contentType": "multipart/form-data"
          }
        },
        {
          "id": "streaming-download",
          "name": "Streaming Download",
          "description": "Tests streaming download with concurrent requests",
          "parameters": {
            "concurrentRequests": 30,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/stream",
            "streamDurationSeconds": 60,
            "expectedStatusCode": 200,
            "timeoutSeconds": 120,
            "bufferSizeKB": 8
          }
        },
        {
          "id": "delayed-response",
          "name": "Delayed Response Handling",
          "description": "Tests handling of deliberately delayed HTTP responses to validate Virtual Thread efficiency",
          "parameters": {
            "concurrentRequests": 200,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/delayed-response",
            "serverDelayMs": [500, 1000, 2000, 5000],
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "measureResourceUsage": true
          }
        }
      ]
    },
    {
      "id": "error-handling",
      "name": "Error Handling with Virtual Threads",
      "description": "Validates error handling behavior when using Virtual Threads for HTTP client operations",
      "testCases": [
        {
          "id": "connection-timeout",
          "name": "Connection Timeout Handling",
          "description": "Tests handling of connection timeouts with Virtual Threads",
          "parameters": {
            "concurrentRequests": 100,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/timeout-simulation",
            "connectionTimeoutMs": 500,
            "expectedExceptionType": "ConnectTimeoutException",
            "timeoutSeconds": 30
          }
        },
        {
          "id": "socket-timeout",
          "name": "Socket Timeout Handling",
          "description": "Tests handling of socket read timeouts with Virtual Threads",
          "parameters": {
            "concurrentRequests": 100,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/slow-response",
            "socketTimeoutMs": 1000,
            "expectedExceptionType": "SocketTimeoutException",
            "timeoutSeconds": 30
          }
        },
        {
          "id": "server-errors",
          "name": "Server Error Handling",
          "description": "Tests handling of server errors (5xx) with Virtual Threads",
          "parameters": {
            "concurrentRequests": 200,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/error-simulation",
            "errorCodes": [500, 502, 503, 504],
            "expectedExceptionType": "HttpResponseException",
            "timeoutSeconds": 30
          }
        },
        {
          "id": "client-errors",
          "name": "Client Error Handling",
          "description": "Tests handling of client errors (4xx) with Virtual Threads",
          "parameters": {
            "concurrentRequests": 200,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/client-error-simulation",
            "errorCodes": [400, 401, 403, 404, 429],
            "expectedExceptionType": "HttpResponseException",
            "timeoutSeconds": 30
          }
        },
        {
          "id": "connection-reset",
          "name": "Connection Reset Handling",
          "description": "Tests handling of connection resets with Virtual Threads",
          "parameters": {
            "concurrentRequests": 100,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/connection-reset-simulation",
            "expectedExceptionType": "ConnectionResetException",
            "timeoutSeconds": 30
          }
        }
      ]
    },
    {
      "id": "connection-pool",
      "name": "Connection Pool Behavior with Virtual Threads",
      "description": "Validates connection pool behavior when using Virtual Threads",
      "testCases": [
        {
          "id": "connection-reuse",
          "name": "Connection Reuse",
          "description": "Tests connection reuse patterns with Virtual Threads",
          "parameters": {
            "concurrentRequests": 500,
            "requestsPerThread": 10,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/connection-info",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "validateConnectionReuse": true
          }
        },
        {
          "id": "connection-eviction",
          "name": "Connection Eviction",
          "description": "Tests connection eviction from the pool with Virtual Threads",
          "parameters": {
            "concurrentRequests": 200,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 30,
            "maxConnectionsPerRoute": 20,
            "maxTotalConnections": 100,
            "connectionTTLSeconds": 5
          }
        },
        {
          "id": "connection-limit",
          "name": "Connection Limit Handling",
          "description": "Tests behavior when connection limits are reached with Virtual Threads",
          "parameters": {
            "concurrentRequests": 1000,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "maxConnectionsPerRoute": 10,
            "maxTotalConnections": 50,
            "validateQueueBehavior": true
          }
        },
        {
          "id": "connection-keepalive",
          "name": "Connection Keep-Alive",
          "description": "Tests keep-alive behavior with Virtual Threads",
          "parameters": {
            "concurrentRequests": 100,
            "requestsPerThread": 5,
            "requestInterval": 2000,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/connection-info",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "keepAliveStrategy": "default"
          }
        }
      ]
    },
    {
      "id": "performance-comparison",
      "name": "Performance Comparison: Virtual vs Platform Threads",
      "description": "Compares performance metrics between Virtual Threads and Platform Threads",
      "testCases": [
        {
          "id": "throughput-comparison",
          "name": "Throughput Comparison",
          "description": "Compares request throughput between Virtual Threads and Platform Threads",
          "parameters": {
            "concurrentRequests": [100, 500, 1000, 5000, 10000],
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 120,
            "warmupIterations": 10,
            "measurementIterations": 20,
            "threadTypes": ["virtual", "platform"]
          }
        },
        {
          "id": "latency-comparison",
          "name": "Latency Comparison",
          "description": "Compares request latency between Virtual Threads and Platform Threads",
          "parameters": {
            "concurrentRequests": [100, 500, 1000, 5000],
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 120,
            "warmupIterations": 10,
            "measurementIterations": 20,
            "threadTypes": ["virtual", "platform"],
            "capturePercentiles": [50, 90, 95, 99]
          }
        },
        {
          "id": "memory-comparison",
          "name": "Memory Usage Comparison",
          "description": "Compares memory usage between Virtual Threads and Platform Threads",
          "parameters": {
            "concurrentRequests": [100, 1000, 10000],
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 120,
            "threadTypes": ["virtual", "platform"],
            "captureMemoryMetrics": ["heap", "non-heap", "thread-stack"]
          }
        },
        {
          "id": "cpu-comparison",
          "name": "CPU Usage Comparison",
          "description": "Compares CPU usage between Virtual Threads and Platform Threads",
          "parameters": {
            "concurrentRequests": [100, 1000, 5000],
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/simple-resource",
            "expectedStatusCode": 200,
            "timeoutSeconds": 120,
            "threadTypes": ["virtual", "platform"],
            "captureCpuMetrics": ["system", "process", "thread"]
          }
        }
      ]
    },
    {
      "id": "thread-pinning",
      "name": "Thread Pinning Detection and Mitigation",
      "description": "Tests to detect and mitigate thread pinning issues with Virtual Threads",
      "testCases": [
        {
          "id": "synchronization-pinning",
          "name": "Synchronization-Based Pinning",
          "description": "Tests for thread pinning caused by synchronization on non-virtual thread objects",
          "parameters": {
            "concurrentRequests": 1000,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/synchronized-operation",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "detectPinning": true,
            "jvmFlag": "-Djdk.tracePinnedThreads=full"
          }
        },
        {
          "id": "blocking-io-pinning",
          "name": "Blocking I/O Pinning",
          "description": "Tests for thread pinning caused by blocking I/O operations",
          "parameters": {
            "concurrentRequests": 500,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/blocking-io-operation",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "detectPinning": true,
            "jvmFlag": "-Djdk.tracePinnedThreads=full"
          }
        },
        {
          "id": "native-method-pinning",
          "name": "Native Method Pinning",
          "description": "Tests for thread pinning caused by native method calls",
          "parameters": {
            "concurrentRequests": 500,
            "requestType": "GET",
            "targetEndpoint": "${test.server.url}/native-method-operation",
            "expectedStatusCode": 200,
            "timeoutSeconds": 60,
            "detectPinning": true,
            "jvmFlag": "-Djdk.tracePinnedThreads=full"
          }
        }
      ]
    },
    {
      "id": "proxy-configuration",
      "name": "Proxy Configuration with Virtual Threads",
      "description": "Tests HTTP client proxy configuration with Virtual Threads",
      "testCases": [
        {
          "id": "http-proxy",
          "name": "HTTP Proxy Configuration",
          "description": "Tests HTTP proxy configuration with Virtual Threads",
          "parameters": {
            "concurrentRequests": 200,
            "requestType": "GET",
            "targetEndpoint": "http://example.com/resource",
            "proxyType": "http",
            "proxyHost": "${test.proxy.host}",
            "proxyPort": "${test.proxy.port}",
            "expectedStatusCode": 200,
            "timeoutSeconds": 30,
            "validateProxyUsage": true
          }
        },
        {
          "id": "https-proxy",
          "name": "HTTPS Proxy Configuration",
          "description": "Tests HTTPS proxy configuration with Virtual Threads",
          "parameters": {
            "concurrentRequests": 200,
            "requestType": "GET",
            "targetEndpoint": "https://example.com/resource",
            "proxyType": "https",
            "proxyHost": "${test.proxy.host}",
            "proxyPort": "${test.proxy.port}",
            "expectedStatusCode": 200,
            "timeoutSeconds": 30,
            "validateProxyUsage": true
          }
        },
        {
          "id": "proxy-authentication",
          "name": "Proxy Authentication",
          "description": "Tests proxy authentication with Virtual Threads",
          "parameters": {
            "concurrentRequests": 100,
            "requestType": "GET",
            "targetEndpoint": "https://example.com/resource",
            "proxyType": "https",
            "proxyHost": "${test.proxy.host}",
            "proxyPort": "${test.proxy.port}",
            "proxyAuth": {
              "username": "${test.proxy.username}",
              "password": "${test.proxy.password}"
            },
            "expectedStatusCode": 200,
            "timeoutSeconds": 30,
            "validateProxyUsage": true
          }
        },
        {
          "id": "non-proxy-hosts",
          "name": "Non-Proxy Hosts Configuration",
          "description": "Tests non-proxy hosts configuration with Virtual Threads",
          "parameters": {
            "concurrentRequests": 100,
            "requestType": "GET",
            "targetEndpoints": [
              "http://localhost:8080/resource",
              "http://internal.example.com/resource",
              "http://example.com/resource"
            ],
            "proxyType": "http",
            "proxyHost": "${test.proxy.host}",
            "proxyPort": "${test.proxy.port}",
            "nonProxyHosts": ["localhost", "*.internal.example.com"],
            "expectedStatusCode": 200,
            "timeoutSeconds": 30,
            "validateProxyUsage": true
          }
        }
      ]
    }
  ]
}