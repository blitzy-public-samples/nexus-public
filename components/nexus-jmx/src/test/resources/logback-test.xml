<configuration>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  
  <!-- Capture file output for test logs -->
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>target/test.log</file>
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Special configuration for virtual thread testing -->
  <logger name="org.sonatype.nexus.virtualthread" level="DEBUG"/>
  
  <!-- Set JMX package to DEBUG to capture detailed JMX operations -->
  <logger name="org.sonatype.nexus.jmx" level="DEBUG"/>
  
  <!-- Set specific loggers for reflection operations which are used in JMX -->
  <logger name="org.sonatype.nexus.jmx.reflect" level="DEBUG"/>
  
  <!-- Root logger set to WARN to reduce noise during test execution -->
  <root level="WARN">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>

</configuration>