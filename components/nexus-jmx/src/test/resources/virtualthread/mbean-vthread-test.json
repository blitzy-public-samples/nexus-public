{
  "metadata": {
    "domain": "org.sonatype.nexus.jmx",
    "objectNameEntries": [
      {
        "name": "foo",
        "value": "bar"
      }
    ],
    "description": "Example managed object for virtual thread testing"
  },
  "attributes": [
    {
      "name": "name",
      "type": "java.lang.String",
      "description": "The name attribute",
      "readable": true,
      "writable": true,
      "testValues": [
        "test1",
        "test2",
        "test3"
      ],
      "expectedResults": {
        "get": "${lastSetValue}",
        "set": true
      },
      "concurrentAccess": {
        "threadCount": 100,
        "operationsPerThread": 50,
        "expectedConsistency": true
      }
    },
    {
      "name": "password",
      "type": "java.lang.String",
      "description": "Set password",
      "readable": false,
      "writable": true,
      "testValues": [
        "password1",
        "password2",
        "password3"
      ],
      "expectedResults": {
        "set": true
      },
      "concurrentAccess": {
        "threadCount": 100,
        "operationsPerThread": 50,
        "expectedConsistency": true
      }
    }
  ],
  "operations": [
    {
      "name": "resetName",
      "description": "Reset name",
      "returnType": "void",
      "parameters": [],
      "expectedResults": {
        "nameAfterReset": null
      },
      "concurrentAccess": {
        "threadCount": 100,
        "operationsPerThread": 20,
        "expectedConsistency": true
      }
    }
  ],
  "virtualThreadTests": [
    {
      "name": "concurrentAttributeAccess",
      "description": "Test concurrent attribute access from multiple virtual threads",
      "setup": {
        "initialAttributeValues": {
          "name": "initialValue"
        }
      },
      "execution": {
        "virtualThreadCount": 1000,
        "operationsPerThread": 100,
        "operationMix": [
          {
            "operation": "getAttribute",
            "attribute": "name",
            "weight": 40
          },
          {
            "operation": "setAttribute",
            "attribute": "name",
            "weight": 40
          },
          {
            "operation": "setAttribute",
            "attribute": "password",
            "weight": 20
          }
        ]
      },
      "validation": {
        "consistencyCheck": true,
        "noExceptions": true,
        "maxExecutionTimeMs": 5000
      }
    },
    {
      "name": "concurrentOperationInvocation",
      "description": "Test concurrent operation invocation from multiple virtual threads",
      "setup": {
        "initialAttributeValues": {
          "name": "valueToReset"
        }
      },
      "execution": {
        "virtualThreadCount": 1000,
        "operationsPerThread": 50,
        "operationMix": [
          {
            "operation": "invoke",
            "method": "resetName",
            "weight": 100
          }
        ]
      },
      "validation": {
        "consistencyCheck": true,
        "noExceptions": true,
        "maxExecutionTimeMs": 5000,
        "finalState": {
          "name": null
        }
      }
    },
    {
      "name": "mixedOperationsTest",
      "description": "Test mixed attribute access and operation invocation from multiple virtual threads",
      "setup": {
        "initialAttributeValues": {
          "name": "mixedTestValue"
        }
      },
      "execution": {
        "virtualThreadCount": 1000,
        "operationsPerThread": 100,
        "operationMix": [
          {
            "operation": "getAttribute",
            "attribute": "name",
            "weight": 30
          },
          {
            "operation": "setAttribute",
            "attribute": "name",
            "weight": 30
          },
          {
            "operation": "setAttribute",
            "attribute": "password",
            "weight": 20
          },
          {
            "operation": "invoke",
            "method": "resetName",
            "weight": 20
          }
        ]
      },
      "validation": {
        "consistencyCheck": true,
        "noExceptions": true,
        "maxExecutionTimeMs": 10000
      }
    }
  ],
  "jmxPerformanceMetrics": {
    "collectMetrics": true,
    "metricsToCollect": [
      "operationInvocationTime",
      "attributeAccessTime",
      "threadCreationTime",
      "threadExecutionTime",
      "threadPinningEvents"
    ],
    "expectedPerformanceImprovements": {
      "throughputIncrease": ">=5x",
      "latencyReduction": ">=50%",
      "resourceUtilization": "<=20%"
    }
  },
  "java21Features": {
    "virtualThreads": {
      "enabled": true,
      "maxConcurrentThreads": 10000,
      "expectedBenefits": [
        "Improved concurrency for I/O-bound operations",
        "Reduced memory footprint compared to platform threads",
        "Simplified thread management without manual pooling",
        "Better scalability for high-concurrency scenarios"
      ]
    },
    "threadPinningDetection": {
      "enabled": true,
      "monitorSynchronizedBlocks": true,
      "monitorNativeMethodCalls": true
    }
  }
}