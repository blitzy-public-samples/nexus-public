  "contentRouting": {
    "rules": [
      {
        "name": "maven-central-routing",
        "description": "Routing rule for Maven Central content",
        "mode": "BLOCK",
        "matchers": [
          "^/org/example/blocked/.*",
          "^/com/example/blocked/.*"
        ]
      },
      {
        "name": "docker-routing",
        "description": "Routing rule for Docker content",
        "mode": "ALLOW",
        "matchers": [
          "^/v2/library/.*",
          "^/v2/approved/.*"
        ]
      }
    ],
    "testPaths": [
      {
        "path": "/org/apache/commons/commons-lang3/3.12.0/commons-lang3-3.12.0.jar",
        "expectedRepository": "maven-central-proxy",
        "expectedResult": "ALLOWED"
      },
      {
        "path": "/org/example/blocked/library/1.0.0/library-1.0.0.jar",
        "expectedRepository": "maven-central-proxy",
        "expectedResult": "BLOCKED"
      },
      {
        "path": "/v2/library/nginx/manifests/1.25.3",
        "expectedRepository": "docker-hub-proxy",
        "expectedResult": "ALLOWED"
      },
      {
        "path": "/v2/unapproved/app/manifests/latest",
        "expectedRepository": "docker-hub-proxy",
        "expectedResult": "BLOCKED"
      }
    ]
  },
  "fluentApiOperations": {
    "browse": [
      {
        "description": "Browse all Maven components",
        "repository": "maven-central-proxy",
        "operation": "components().browse()",
        "expectedResultCount": 5000,
        "paginationSize": 100
      },
      {
        "description": "Browse assets by name pattern",
        "repository": "maven-releases",
        "operation": "assets().byNameMatching('.*\\.jar$').browse()",
        "expectedResultCount": 5000,
        "paginationSize": 100
      },
      {
        "description": "Browse components by namespace",
        "repository": "npm-registry-proxy",
        "operation": "components().byNamespace('@angular').browse()",
        "expectedResultCount": 200,
        "paginationSize": 50
      }
    ],
    "search": [
      {
        "description": "Search for specific Maven artifact",
        "repository": "maven-group",
