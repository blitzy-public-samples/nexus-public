{
  "metadata": {
    "version": "1.0.0",
    "description": "Test data for virtual thread concurrency stress testing of repository content operations",
    "testPurpose": "Validate repository content operations under high concurrency with Java 21 Virtual Threads",
    "targetScalingEfficiency": 90,
    "created": "2025-05-19T10:00:00Z"
  },
  "testScenarios": [
    {
      "name": "asset-retrieval-concurrency",
      "description": "Test concurrent asset retrieval operations using virtual threads",
      "concurrencyLevels": [100, 500, 1000, 5000, 10000],
      "operations": ["read", "browse", "search"],
      "validationCriteria": {
        "responseTimeThresholdMs": 500,
        "successRateThreshold": 99.5,
        "threadPinningAllowed": false
      }
    },
    {
      "name": "component-browsing-concurrency",
      "description": "Test concurrent component browsing operations using virtual threads",
      "concurrencyLevels": [100, 500, 1000, 2500, 5000],
      "operations": ["browse", "search", "filter"],
      "validationCriteria": {
        "responseTimeThresholdMs": 750,
        "successRateThreshold": 99.0,
        "threadPinningAllowed": false
      }
    },
    {
      "name": "content-routing-concurrency",
      "description": "Test concurrent content routing operations using virtual threads",
      "concurrencyLevels": [50, 250, 500, 1000, 2000],
      "operations": ["route", "resolve", "redirect"],
      "validationCriteria": {
        "responseTimeThresholdMs": 300,
        "successRateThreshold": 99.8,
        "threadPinningAllowed": false
      }
    },
    {
      "name": "fluent-api-concurrency",
      "description": "Test concurrent fluent API operations using virtual threads",
      "concurrencyLevels": [100, 500, 1000, 2000, 5000],
      "operations": ["query", "transform", "filter"],
      "validationCriteria": {
        "responseTimeThresholdMs": 400,
        "successRateThreshold": 99.5,
        "threadPinningAllowed": false
      }
    },
    {
      "name": "mixed-workload-concurrency",
      "description": "Test mixed workload operations using virtual threads",
      "concurrencyLevels": [500, 1000, 5000, 10000, 20000],
      "operations": ["read", "browse", "search", "route", "query"],
      "validationCriteria": {
        "responseTimeThresholdMs": 800,
        "successRateThreshold": 98.5,
        "threadPinningAllowed": false
      }
    }
  ],
