  "virtualThreadTestConfigurations": {
    "threadCreationMethods": [
      {
        "name": "virtualThreadPerTaskExecutor",
        "code": "Executors.newVirtualThreadPerTaskExecutor()",
        "description": "Creates an executor that creates a new virtual thread for each task"
      },
      {
        "name": "threadFactory",
        "code": "Thread.ofVirtual().name(\"vt-\", 0).factory()",
        "description": "Creates a thread factory that creates named virtual threads"
      },
      {
        "name": "directCreation",
        "code": "Thread.startVirtualThread(() -> task)",
        "description": "Directly creates and starts a virtual thread"
      }
    ],
    "pinningDetectionTests": [
      {
        "name": "synchronizedBlockTest",
        "description": "Test for pinning with synchronized blocks",
        "code": "synchronized(lock) { /* repository operation */ }",
        "expectedPinning": true,
        "recommendation": "Replace with ReentrantLock or other java.util.concurrent lock"
      },
      {
        "name": "reentrantLockTest",
        "description": "Test for pinning with ReentrantLock",
        "code": "lock.lock(); try { /* repository operation */ } finally { lock.unlock(); }",
        "expectedPinning": false,
        "recommendation": "Preferred approach for locking with virtual threads"
      },
      {
        "name": "threadLocalTest",
        "description": "Test for ThreadLocal impact on virtual threads",
        "code": "ThreadLocal<Context> contextHolder = new ThreadLocal<>();",
        "expectedPinning": false,
        "recommendation": "Use ThreadLocal sparingly with virtual threads to reduce memory usage"
      },
      {
        "name": "nativeMethodTest",
        "description": "Test for pinning with native methods",
        "code": "/* call to native method during repository operation */",
        "expectedPinning": true,
        "recommendation": "Avoid native method calls in virtual thread execution path"
      }
    ],
    "scalingEfficiencyTests": [
      {
        "name": "repositoryContentScaling",
        "description": "Test scaling efficiency of repository content operations",
        "concurrencyLevels": [100, 500, 1000, 5000, 10000, 20000],
        "expectedEfficiency": 95,
        "operationsPerSecondBaseline": 1000
      },
      {
        "name": "assetRetrievalScaling",
        "description": "Test scaling efficiency of asset retrieval operations",
        "concurrencyLevels": [100, 500, 1000, 5000, 10000, 20000],
        "expectedEfficiency": 90,
        "operationsPerSecondBaseline": 2000
      },
      {
        "name": "contentRoutingScaling",
        "description": "Test scaling efficiency of content routing operations",
        "concurrencyLevels": [100, 500, 1000, 5000, 10000],
        "expectedEfficiency": 98,
        "operationsPerSecondBaseline": 5000
      }
    ]
  }
