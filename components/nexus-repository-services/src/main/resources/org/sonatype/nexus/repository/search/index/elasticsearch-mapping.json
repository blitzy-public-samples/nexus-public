{
  "settings": {
    "index" : {
      "number_of_shards" : 1,
      "number_of_replicas" : 0,
      "refresh_interval" : "5s"
    },
    "analysis": {
      "analyzer": {
        "case_insensitive_sort": {
          "tokenizer": "keyword",
          "filter": [
            "lowercase"
          ]
        }
      }
    }
  },
  "mappings": {
    "component": {
      "properties": {
        "assets": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "attributes": {
              "properties": {
                "checksum": {
                  "properties": {
                    "md5": {
                      "type": "keyword"
                    },
                    "sha1": {
                      "type": "keyword"
                    }
                  }
                }
              }
            },
            "content_type": {
              "type": "keyword"
            },
            "last_updated": {
              "type": "long"
            },
            "id": {
              "type": "keyword"
            }
          }
        },
        "format": {
          "type": "keyword"
        },
        "group": {
          "type": "text",
          "fields": {
            "case_insensitive": {
              "type": "text",
              "analyzer": "case_insensitive_sort"
            },
            "raw": {
              "type": "keyword"
            }
          }
        },
        "name": {
          "type": "text",
          "fields": {
            "case_insensitive": {
              "type": "text",
              "analyzer": "case_insensitive_sort"
            },
            "raw": {
              "type": "keyword"
            }
          }
        },
        "repository_name": {
          "type": "keyword"
        },
        "version": {
          "type": "keyword"
        },
        "normalized_version": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        },
        "lastDownloaded": {
          "type": "date",
          "format": "strict_date_optional_time||epoch_millis"
        },
        "lastBlobUpdated" : {
          "type" : "date",
          "format": "strict_date_optional_time||epoch_millis"
        }
      }
    }
  }
}