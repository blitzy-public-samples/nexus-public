<!-- 
Matcher configuration for testing repository view matchers with Virtual Threads.
This file defines various matcher configurations used to validate that the repository view's
content negotiation and request matching logic functions correctly when executed via Virtual Threads in Java 21.
-->
<matcher-configs>
  <!-- 
  Basic matcher configurations for testing simple pattern matching with Virtual Threads.
  Tests the fundamental matcher types with minimal complexity.
  -->
  <matcher-config id="basic-literal-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.LiteralMatcher">
      <description>Tests exact path matching with Virtual Threads</description>
      <property name="literal" value="/content/maven-central/org/apache/maven/maven-core/3.9.5/maven-core-3.9.5.jar"/>
      <property name="ignoreCase" value="false"/>
    </matcher>
  </matcher-config>
  
  <matcher-config id="basic-regex-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.RegexMatcher">
      <description>Tests regular expression path matching with Virtual Threads</description>
      <property name="regex" value="/content/maven-central/org/apache/maven/maven-core/\d+\.\d+\.\d+/maven-core-\d+\.\d+\.\d+\.jar"/>
    </matcher>
  </matcher-config>
  
  <matcher-config id="basic-suffix-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
      <description>Tests suffix-based path matching with Virtual Threads</description>
      <property name="suffix" value=".jar"/>
      <property name="ignoreCase" value="true"/>
    </matcher>
  </matcher-config>
  
  <matcher-config id="basic-prefix-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.PrefixMatcher">
      <description>Tests prefix-based path matching with Virtual Threads</description>
      <property name="prefix" value="/content/maven-central"/>
      <property name="ignoreCase" value="false"/>
    </matcher>
  </matcher-config>
  
  <matcher-config id="basic-action-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.ActionMatcher">
      <description>Tests HTTP action matching with Virtual Threads</description>
      <property name="actions" value="GET,HEAD"/>
    </matcher>
  </matcher-config>
  
  <matcher-config id="basic-token-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.token.TokenMatcher">
      <description>Tests token-based path template matching with Virtual Threads</description>
      <property name="pattern" value="/content/{repository}/{group:.+}/{name}/{version}/{name}-{version}.{extension}"/>
    </matcher>
  </matcher-config>
  
  <!-- 
  Composite matcher configurations for testing boolean logic combinations with Virtual Threads.
  Tests how matchers behave when combined with AND, OR, NOT operators under Virtual Threads.
  -->
  <matcher-config id="and-matcher-combination">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.AndMatcher">
      <description>Tests AND combination of matchers with Virtual Threads</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.ActionMatcher">
          <property name="actions" value="GET"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
          <property name="suffix" value=".jar"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.PrefixMatcher">
          <property name="prefix" value="/content/maven-central"/>
        </matcher>
      </matchers>
    </matcher>
  </matcher-config>
  
  <matcher-config id="or-matcher-combination">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.OrMatcher">
      <description>Tests OR combination of matchers with Virtual Threads</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
          <property name="suffix" value=".jar"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
          <property name="suffix" value=".pom"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
          <property name="suffix" value=".war"/>
        </matcher>
      </matchers>
    </matcher>
  </matcher-config>
  
  <matcher-config id="not-matcher-combination">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.NotMatcher">
      <description>Tests NOT combination of matchers with Virtual Threads</description>
      <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
        <property name="suffix" value=".md5"/>
      </matcher>
    </matcher>
  </matcher-config>
  
  <matcher-config id="complex-nested-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.AndMatcher">
      <description>Tests complex nested matcher combinations with Virtual Threads</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.ActionMatcher">
          <property name="actions" value="GET"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.logic.OrMatcher">
          <matchers>
            <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
              <property name="suffix" value=".jar"/>
            </matcher>
            <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
              <property name="suffix" value=".pom"/>
            </matcher>
          </matchers>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.logic.NotMatcher">
          <matcher class="org.sonatype.nexus.repository.view.matchers.PrefixMatcher">
            <property name="prefix" value="/content/snapshots"/>
          </matcher>
        </matcher>
      </matchers>
    </matcher>
  </matcher-config>
  
  <!-- 
  Performance-focused matcher configurations for testing Virtual Thread efficiency.
  Tests how matchers perform under high concurrency with Virtual Threads.
  -->
  <matcher-config id="high-concurrency-token-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.token.TokenMatcher">
      <description>Tests token matcher performance with many variables under Virtual Threads</description>
      <property name="pattern" value="/content/{repository}/{group1}/{group2}/{group3}/{group4}/{group5}/{name}/{version}/{name}-{version}.{extension}"/>
    </matcher>
  </matcher-config>
  
  <matcher-config id="complex-regex-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.RegexMatcher">
      <description>Tests complex regex matcher performance with Virtual Threads</description>
      <property name="regex" value="/content/maven-(central|public|releases|snapshots)/([^/]+/){2,8}[^/]+-\d+\.\d+\.\d+(-SNAPSHOT)?\.(jar|pom|war|ear|zip)"/>
    </matcher>
  </matcher-config>
  
  <!-- 
  Content negotiation matcher configurations for testing with Virtual Threads.
  Tests matchers used for content negotiation under Virtual Threads.
  -->
  <matcher-config id="content-negotiation-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.AndMatcher">
      <description>Tests content negotiation matching with Virtual Threads</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.ActionMatcher">
          <property name="actions" value="GET"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.token.TokenMatcher">
          <property name="pattern" value="/content/{repository}/{path:.+}"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.logic.OrMatcher">
          <matchers>
            <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
              <property name="suffix" value=".jar"/>
            </matcher>
            <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
              <property name="suffix" value=".pom"/>
            </matcher>
            <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
              <property name="suffix" value=".war"/>
            </matcher>
            <matcher class="org.sonatype.nexus.repository.view.matchers.SuffixMatcher">
              <property name="suffix" value=".ear"/>
            </matcher>
          </matchers>
        </matcher>
      </matchers>
    </matcher>
  </matcher-config>
  
  <!-- 
  Thread safety test matcher configurations for Virtual Threads.
  Tests matchers that might have thread safety issues when used with Virtual Threads.
  -->
  <matcher-config id="thread-safety-test-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.AndMatcher">
      <description>Tests thread safety of matchers with Virtual Threads</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.token.TokenMatcher">
          <property name="pattern" value="/content/{repository}/{group:.+}/{name}/{version}/{name}-{version}.{extension}"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.RegexMatcher">
          <property name="regex" value=".*-\d+\.\d+\.\d+.*"/>
        </matcher>
      </matchers>
    </matcher>
  </matcher-config>
  
  <!-- 
  Pattern matching test configurations for Java 21 features.
  Tests matchers that could benefit from Java 21 Pattern Matching improvements.
  -->
  <matcher-config id="pattern-matching-optimized-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.AndMatcher">
      <description>Tests matchers optimized with Java 21 Pattern Matching</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.ActionMatcher">
          <property name="actions" value="GET,HEAD,PUT,DELETE"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.token.TokenMatcher">
          <property name="pattern" value="/content/{repository}/{format}/{path:.+}"/>
        </matcher>
      </matchers>
    </matcher>
  </matcher-config>
  
  <!-- 
  Virtual Thread specific test configurations.
  Tests matchers with configurations specific to Virtual Thread behavior.
  -->
  <matcher-config id="virtual-thread-specific-matcher">
    <matcher class="org.sonatype.nexus.repository.view.matchers.logic.AndMatcher">
      <description>Tests Virtual Thread specific matcher behavior</description>
      <matchers>
        <matcher class="org.sonatype.nexus.repository.view.matchers.token.TokenMatcher">
          <property name="pattern" value="/content/{repository}/{path:.+}"/>
        </matcher>
        <matcher class="org.sonatype.nexus.repository.view.matchers.ActionMatcher">
          <property name="actions" value="GET"/>
        </matcher>
        <property name="virtualThreadOptimized" value="true"/>
      </matchers>
    </matcher>
  </matcher-config>
</matcher-configs>