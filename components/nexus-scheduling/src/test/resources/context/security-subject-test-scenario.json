{
  "testName": "SecuritySubjectPropagationTest",
  "description": "Test scenarios for validating security subject propagation across virtual thread boundaries in scheduled tasks",
  "version": "1.0",
  
  "subjects": [
    {
      "id": "admin",
      "description": "Administrator with all permissions",
      "principal": "admin",
      "authenticated": true,
      "roles": ["nx-admin"],
      "permissions": ["*"],
      "attributes": {
        "userId": "admin",
        "userSource": "default",
        "remoteIp": "127.0.0.1"
      }
    },
    {
      "id": "developer",
      "description": "Developer with limited permissions",
      "principal": "developer",
      "authenticated": true,
      "roles": ["nx-developer"],
      "permissions": [
        "nexus:repository-admin:maven2:*:read",
        "nexus:repository-admin:maven2:*:browse",
        "nexus:repository-view:maven2:*:read",
        "nexus:repository-view:maven2:*:browse"
      ],
      "attributes": {
        "userId": "developer",
        "userSource": "default",
        "remoteIp": "127.0.0.1"
      }
    },
    {
      "id": "anonymous",
      "description": "Anonymous user with minimal permissions",
      "principal": "anonymous",
      "authenticated": false,
      "roles": ["nx-anonymous"],
      "permissions": [
        "nexus:repository-view:maven2:maven-central:read",
        "nexus:repository-view:maven2:maven-central:browse"
      ],
      "attributes": {
        "userId": "anonymous",
        "userSource": "default",
        "remoteIp": "127.0.0.1"
      }
    },
    {
      "id": "system",
      "description": "System user for internal operations",
      "principal": "system",
      "authenticated": true,
      "roles": ["nx-admin"],
      "permissions": ["*"],
      "attributes": {
        "userId": "system",
        "userSource": "default",
        "internal": true
      }
    },
    {
      "id": "expired",
      "description": "User with expired session",
      "principal": "expired",
      "authenticated": false,
      "sessionExpired": true,
      "roles": [],
      "permissions": [],
      "attributes": {
        "userId": "expired",
        "userSource": "default",
        "remoteIp": "127.0.0.1"
      }
    }
  ],
  
  "testScenarios": [
    {
      "id": "basic-subject-propagation",
      "description": "Verify basic subject identity propagation across virtual thread boundaries",
      "subjectId": "admin",
      "taskType": "io-bound",
      "validations": [
        {
          "type": "identity",
          "description": "Subject principal should be preserved",
          "property": "principal",
          "expectedValue": "admin"
        },
        {
          "type": "authentication",
          "description": "Authentication state should be preserved",
          "property": "authenticated",
          "expectedValue": true
        },
        {
          "type": "attribute",
          "description": "User attributes should be preserved",
          "property": "userId",
          "expectedValue": "admin"
        }
      ]
    },
    {
      "id": "permission-propagation",
      "description": "Verify permission propagation across virtual thread boundaries",
      "subjectId": "developer",
      "taskType": "io-bound",
      "validations": [
        {
          "type": "permission",
          "description": "Subject should have expected permissions",
          "permission": "nexus:repository-view:maven2:*:read",
          "expectedResult": true
        },
        {
          "type": "permission",
          "description": "Subject should not have admin permissions",
          "permission": "nexus:*:*:*:delete",
          "expectedResult": false
        }
      ]
    },
    {
      "id": "role-propagation",
      "description": "Verify role propagation across virtual thread boundaries",
      "subjectId": "developer",
      "taskType": "io-bound",
      "validations": [
        {
          "type": "role",
          "description": "Subject should have expected role",
          "role": "nx-developer",
          "expectedResult": true
        },
        {
          "type": "role",
          "description": "Subject should not have admin role",
          "role": "nx-admin",
          "expectedResult": false
        }
      ]
    },
    {
      "id": "anonymous-propagation",
      "description": "Verify anonymous subject propagation across virtual thread boundaries",
      "subjectId": "anonymous",
      "taskType": "io-bound",
      "validations": [
        {
          "type": "identity",
          "description": "Anonymous principal should be preserved",
          "property": "principal",
          "expectedValue": "anonymous"
        },
        {
          "type": "authentication",
          "description": "Authentication state should be preserved as false",
          "property": "authenticated",
          "expectedValue": false
        },
        {
          "type": "permission",
          "description": "Anonymous permissions should be limited",
          "permission": "nexus:repository-view:maven2:maven-central:read",
          "expectedResult": true
        }
      ]
    },
    {
      "id": "system-propagation",
      "description": "Verify system subject propagation across virtual thread boundaries",
      "subjectId": "system",
      "taskType": "io-bound",
      "validations": [
        {
          "type": "identity",
          "description": "System principal should be preserved",
          "property": "principal",
          "expectedValue": "system"
        },
        {
          "type": "attribute",
          "description": "Internal attribute should be preserved",
          "property": "internal",
          "expectedValue": true
        }
      ]
    },
    {
      "id": "expired-session-handling",
      "description": "Verify expired session handling across virtual thread boundaries",
      "subjectId": "expired",
      "taskType": "io-bound",
      "validations": [
        {
          "type": "authentication",
          "description": "Authentication state should be preserved as false",
          "property": "authenticated",
          "expectedValue": false
        },
        {
          "type": "session",
          "description": "Session expired state should be preserved",
          "property": "sessionExpired",
          "expectedValue": true
        }
      ]
    },
    {
      "id": "concurrent-subject-isolation",
      "description": "Verify subject isolation between concurrent virtual threads",
      "concurrentSubjects": ["admin", "developer", "anonymous"],
      "taskType": "io-bound",
      "validations": [
        {
          "type": "isolation",
          "description": "Each thread should maintain its own subject identity",
          "property": "principal",
          "expectedValues": ["admin", "developer", "anonymous"]
        },
        {
          "type": "isolation",
          "description": "Permissions should not leak between threads",
          "property": "permissions",
          "noLeakage": true
        }
      ]
    },
    {
      "id": "thread-pinning-security",
      "description": "Verify security context with operations that may cause thread pinning",
      "subjectId": "developer",
      "taskType": "thread-pinning",
      "validations": [
        {
          "type": "identity",
          "description": "Subject identity should be preserved even with thread pinning",
          "property": "principal",
          "expectedValue": "developer"
        },
        {
          "type": "permission",
          "description": "Permissions should be preserved even with thread pinning",
          "permission": "nexus:repository-view:maven2:*:read",
          "expectedResult": true
        }
      ]
    },
    {
      "id": "long-running-task-security",
      "description": "Verify security context maintained for long-running tasks",
      "subjectId": "admin",
      "taskType": "io-bound",
      "taskDurationMs": 5000,
      "validations": [
        {
          "type": "identity",
          "description": "Subject identity should be preserved for long-running tasks",
          "property": "principal",
          "expectedValue": "admin"
        },
        {
          "type": "authentication",
          "description": "Authentication state should be preserved for long-running tasks",
          "property": "authenticated",
          "expectedValue": true
        }
      ]
    },
    {
      "id": "nested-virtual-threads",
      "description": "Verify security context propagation through nested virtual threads",
      "subjectId": "developer",
      "taskType": "nested-virtual-threads",
      "nestingLevels": 3,
      "validations": [
        {
          "type": "identity",
          "description": "Subject identity should be preserved through all nesting levels",
          "property": "principal",
          "expectedValue": "developer",
          "atAllLevels": true
        },
        {
          "type": "permission",
          "description": "Permissions should be preserved through all nesting levels",
          "permission": "nexus:repository-view:maven2:*:read",
          "expectedResult": true,
          "atAllLevels": true
        }
      ]
    }
  ],
  
  "taskTypes": {
    "io-bound": {
      "description": "I/O-bound task for testing security context propagation",
      "className": "org.sonatype.nexus.scheduling.test.SecurityContextTestTask",
      "parameters": {
        "operationType": "IO_BOUND",
        "durationMs": 1000,
        "useVirtualThreads": true
      }
    },
    "thread-pinning": {
      "description": "Task with operations that may cause thread pinning",
      "className": "org.sonatype.nexus.scheduling.test.ThreadPinningTestTask",
      "parameters": {
        "synchronizedBlockCount": 5,
        "blockingNativeCallCount": 3,
        "monitorWaitTimeMs": 100,
        "useVirtualThreads": true
      }
    },
    "nested-virtual-threads": {
      "description": "Task that creates nested virtual threads",
      "className": "org.sonatype.nexus.scheduling.test.NestedVirtualThreadTestTask",
      "parameters": {
        "nestingLevels": 3,
        "operationsPerLevel": 5,
        "useVirtualThreads": true
      }
    }
  }
}