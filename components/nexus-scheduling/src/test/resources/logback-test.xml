<configuration>
  <!-- 
    Specialized Logback configuration for the scheduling module tests that enables detailed 
    thread diagnostics logging, captures MDC context for tasks executed via virtual threads, 
    and configures appenders for capturing thread lifecycle events.
  -->

  <!-- Console appender with detailed pattern for virtual thread diagnostics -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- 
        Enhanced pattern that includes:
        - Timestamp with millisecond precision
        - Log level
        - Thread name with special formatting for virtual threads
        - Logger name
        - Message
        - MDC context (preserves context across thread boundaries)
        - Exception stack trace if present
      -->
      <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg %X{taskId:--}%X{taskType:--}%X{taskName:--}%X{userId:--} %mdc%n</pattern>
    </encoder>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>DEBUG</level>
    </filter>
  </appender>

  <!-- Thread dump appender for capturing thread state during test failures -->
  <appender name="THREAD-DUMP" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>target/thread-dump.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>target/thread-dump.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>3</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>5MB</maxFileSize>
    </triggeringPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  
  <!-- Virtual Thread diagnostics appender -->
  <appender name="VIRTUAL-THREAD" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>target/virtual-thread.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
      <fileNamePattern>target/virtual-thread.%i.log</fileNamePattern>
      <minIndex>1</minIndex>
      <maxIndex>3</maxIndex>
    </rollingPolicy>
    <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
      <maxFileSize>5MB</maxFileSize>
    </triggeringPolicy>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg %X{taskId:--}%X{taskType:--}%X{taskName:--}%X{userId:--}%n</pattern>
    </encoder>
  </appender>

  <!-- Virtual thread specific logger configurations -->
  
  <!-- Set JDK virtual thread implementation classes to TRACE level -->
  <logger name="java.lang.VirtualThread" level="TRACE">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  <logger name="jdk.internal.vm.Continuation" level="TRACE">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  
  <!-- Set Nexus thread-related classes to TRACE level -->
  <logger name="org.sonatype.nexus.thread" level="TRACE">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  <logger name="org.sonatype.nexus.scheduling" level="TRACE"/>
  <logger name="org.sonatype.nexus.scheduling.internal" level="TRACE"/>
  
  <!-- Special logger for thread pinning detection -->
  <logger name="org.sonatype.nexus.thread.internal.MDCPreservingVirtualThreadFactory" level="DEBUG">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  
  <!-- Capture thread lifecycle events -->
  <logger name="org.sonatype.nexus.common.stateguard" level="DEBUG"/>
  <logger name="org.sonatype.nexus.common.thread" level="DEBUG">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  
  <!-- Configure MDC propagation for virtual threads -->
  <logger name="org.sonatype.nexus.thread.internal.MDCPreservingExecutorServiceFactory" level="DEBUG">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  
  <!-- Thread pinning detection loggers -->
  <logger name="jdk.internal.vm.ThreadPinningDetails" level="TRACE">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  <logger name="java.util.concurrent.ThreadPoolExecutor" level="DEBUG">
    <appender-ref ref="VIRTUAL-THREAD"/>
  </logger>
  
  <!-- Task execution context loggers -->
  <logger name="org.sonatype.nexus.scheduling.TaskInfo" level="DEBUG"/>
  <logger name="org.sonatype.nexus.scheduling.TaskConfiguration" level="DEBUG"/>
  <logger name="org.sonatype.nexus.scheduling.TaskState" level="DEBUG"/>
  
  <!-- MDC propagation configuration -->
  <turboFilter class="ch.qos.logback.classic.turbo.MDCFilter">
    <MDCKey>taskId</MDCKey>
    <Value>*</Value>
    <OnMatch>ACCEPT</OnMatch>
  </turboFilter>
  
  <!-- Root logger configuration -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="THREAD-DUMP"/>
  </root>

  <!-- 
    System property configuration for virtual thread diagnostics:
    - jdk.tracePinnedThreads=full: Enables detailed tracking of thread pinning events
    - jdk.virtualThreadScheduler.maxPoolSize: Controls the maximum number of carrier threads
    - jdk.virtualThreadScheduler.parallelism: Controls the target parallelism level
  -->
  <contextListener class="ch.qos.logback.classic.jul.LevelChangePropagator">
    <resetJUL>true</resetJUL>
  </contextListener>
  
  <!-- 
    Note: For optimal virtual thread diagnostics, the following JVM arguments are recommended:
    -Djdk.tracePinnedThreads=full
    -Djdk.virtualThreadScheduler.maxPoolSize=256
    -Djdk.virtualThreadScheduler.parallelism=16
    -Djdk.traceVirtualThreadLocals=true
  -->

</configuration>