{
  "templates": [
    {
      "id": "repository-proxy-fetch",
      "name": "Repository Proxy Fetch Task",
      "description": "Simulates proxy repository fetch operations with high I/O and network latency, ideal for virtual threads",
      "type": "io-bound",
      "parameters": {
        "repositoryName": "maven-central",
        "assetCount": 100,
        "remoteLatencyMs": 200,
        "concurrentFetches": 50,
        "blobSizeBytes": 1048576,
        "retryCount": 3,
        "timeoutMs": 30000
      }
    },
    {
      "id": "s3-blobstore-operations",
      "name": "S3 BlobStore Operations Task",
      "description": "Simulates S3 blob storage operations with network latency, excellent for demonstrating virtual thread benefits",
      "type": "io-bound",
      "parameters": {
        "blobStoreType": "s3",
        "blobCount": 200,
        "blobSizeBytes": 2097152,
        "readWriteRatio": 4,
        "networkLatencyMs": 100,
        "concurrentOperations": 100,
        "retryCount": 3,
        "timeoutMs": 60000,
        "s3Region": "us-east-1",
        "operationTypes": ["GET", "PUT", "LIST", "DELETE"]
      }
    },
    {
      "id": "database-operations",
      "name": "Database Operations Task",
      "description": "Simulates database operations with JDBC, ideal for testing virtual thread compatibility with database drivers",
      "type": "io-bound",
      "parameters": {
        "databaseType": "postgresql",
        "queryCount": 500,
        "queryTypes": ["SELECT", "INSERT", "UPDATE", "DELETE"],
        "queryTypeDistribution": [70, 10, 10, 10],
        "rowsPerQuery": 100,
        "dbLatencyMs": 50,
        "concurrentQueries": 100,
        "useTransactions": true,
        "transactionSize": 10,
        "connectionPoolSize": 20,
        "queryTimeout": 5000
      }
    },
    {
      "id": "file-system-operations",
      "name": "File System Operations Task",
      "description": "Simulates file system operations with varying I/O patterns, ideal for virtual threads",
      "type": "io-bound",
      "parameters": {
        "fileCount": 1000,
        "fileSizeBytes": 1048576,
        "operationTypes": ["READ", "WRITE", "COPY", "DELETE"],
        "operationTypeDistribution": [50, 20, 20, 10],
        "concurrentOperations": 100,
        "ioLatencyMs": 30,
        "directoryDepth": 5,
        "filesPerDirectory": 20,
        "bufferSizeBytes": 8192,
        "fsyncFrequency": 10
      }
    },
    {
      "id": "http-client-operations",
      "name": "HTTP Client Operations Task",
      "description": "Simulates HTTP client operations with varying network conditions, perfect for virtual threads",
      "type": "io-bound",
      "parameters": {
        "requestCount": 500,
        "requestTypes": ["GET", "POST", "PUT", "DELETE"],
        "requestTypeDistribution": [60, 20, 15, 5],
        "concurrentRequests": 200,
        "networkLatencyMs": 150,
        "responseTimeoutMs": 10000,
        "connectionTimeoutMs": 5000,
        "requestSizeBytes": 8192,
        "responseSizeBytes": 32768,
        "useKeepAlive": true,
        "endpoints": ["api/v1/components", "api/v1/assets", "api/v1/repositories"],
        "httpVersion": "HTTP/1.1"
      }
    },
    {
      "id": "mixed-repository-operations",
      "name": "Mixed Repository Operations Task",
      "description": "Simulates a mix of repository operations with both I/O and light CPU work, demonstrating virtual thread advantages",
      "type": "io-bound",
      "parameters": {
        "repositoryTypes": ["maven", "npm", "docker", "raw"],
        "operationCount": 1000,
        "operationTypes": ["BROWSE", "SEARCH", "DOWNLOAD", "UPLOAD"],
        "operationTypeDistribution": [30, 30, 30, 10],
        "concurrentOperations": 150,
        "networkLatencyMs": 80,
        "dbLatencyMs": 40,
        "ioLatencyMs": 20,
        "cpuWorkPerOperationMs": 5,
        "assetSizeBytes": 524288,
        "metadataSize": 4096
      }
    },
    {
      "id": "thread-pinning-detection",
      "name": "Thread Pinning Detection Task",
      "description": "Tests operations that may cause thread pinning with virtual threads to verify JDBC driver compatibility",
      "type": "io-bound",
      "parameters": {
        "databaseType": "postgresql",
        "operationCount": 1000,
        "operationTypes": ["QUERY", "TRANSACTION", "BATCH", "PREPARED_STATEMENT"],
        "operationTypeDistribution": [40, 30, 20, 10],
        "concurrentOperations": 200,
        "dbLatencyMs": 30,
        "transactionSizeOperations": 10,
        "batchSize": 50,
        "connectionPoolSize": 20,
        "monitorJvmFlag": "-Djdk.tracePinnedThreads=full",
        "detectPinning": true,
        "pinnedThreadThreshold": 5
      }
    }
  ],
  "metadata": {
    "description": "Task templates for testing I/O-bound operations with Java 21 Virtual Threads",
    "version": "1.0",
    "targetJavaVersion": "21",
    "createdAt": "2023-10-15",
    "updatedAt": "2023-10-15"
  }
}