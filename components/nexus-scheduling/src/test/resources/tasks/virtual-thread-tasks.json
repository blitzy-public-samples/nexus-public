{
  "tasks": [
    {
      "id": "io-bound-task",
      "name": "I/O-Bound Virtual Thread Test Task",
      "description": "Tests virtual thread performance with I/O-bound operations",
      "type": "simple",
      "properties": {
        "operationType": "io",
        "operationCount": 1000,
        "delayMs": 50,
        "useVirtualThreads": true,
        "threadPoolSize": 100,
        "collectMetrics": true
      }
    },
    {
      "id": "io-bound-platform-task",
      "name": "I/O-Bound Platform Thread Test Task",
      "description": "Tests platform thread performance with I/O-bound operations for comparison",
      "type": "simple",
      "properties": {
        "operationType": "io",
        "operationCount": 1000,
        "delayMs": 50,
        "useVirtualThreads": false,
        "threadPoolSize": 100,
        "collectMetrics": true
      }
    },
    {
      "id": "cpu-bound-task",
      "name": "CPU-Bound Virtual Thread Test Task",
      "description": "Tests virtual thread performance with CPU-bound operations",
      "type": "simple",
      "properties": {
        "operationType": "cpu",
        "operationCount": 100,
        "iterationsPerOperation": 10000,
        "useVirtualThreads": true,
        "threadPoolSize": 16,
        "collectMetrics": true
      }
    },
    {
      "id": "cpu-bound-platform-task",
      "name": "CPU-Bound Platform Thread Test Task",
      "description": "Tests platform thread performance with CPU-bound operations for comparison",
      "type": "simple",
      "properties": {
        "operationType": "cpu",
        "operationCount": 100,
        "iterationsPerOperation": 10000,
        "useVirtualThreads": false,
        "threadPoolSize": 16,
        "collectMetrics": true
      }
    },
    {
      "id": "mixed-workload-task",
      "name": "Mixed Workload Virtual Thread Test Task",
      "description": "Tests virtual thread performance with mixed CPU and I/O operations",
      "type": "simple",
      "properties": {
        "operationType": "mixed",
        "operationCount": 500,
        "ioRatio": 0.7,
        "delayMs": 30,
        "iterationsPerOperation": 5000,
        "useVirtualThreads": true,
        "threadPoolSize": 50,
        "collectMetrics": true
      }
    },
    {
      "id": "mixed-workload-platform-task",
      "name": "Mixed Workload Platform Thread Test Task",
      "description": "Tests platform thread performance with mixed CPU and I/O operations for comparison",
      "type": "simple",
      "properties": {
        "operationType": "mixed",
        "operationCount": 500,
        "ioRatio": 0.7,
        "delayMs": 30,
        "iterationsPerOperation": 5000,
        "useVirtualThreads": false,
        "threadPoolSize": 50,
        "collectMetrics": true
      }
    },
    {
      "id": "thread-pinning-test-task",
      "name": "Thread Pinning Test Task",
      "description": "Tests virtual thread pinning behavior with synchronized blocks",
      "type": "simple",
      "properties": {
        "operationType": "pinning",
        "operationCount": 200,
        "synchronizedBlockCount": 50,
        "nativeCallCount": 20,
        "useVirtualThreads": true,
        "threadPoolSize": 30,
        "detectPinning": true,
        "collectMetrics": true,
        "captureStackTraces": true
      }
    },
    {
      "id": "scalability-test-task",
      "name": "Scalability Test Task",
      "description": "Tests virtual thread scalability with increasing concurrent operations",
      "type": "simple",
      "properties": {
        "operationType": "scalability",
        "startConcurrency": 100,
        "maxConcurrency": 10000,
        "concurrencyStep": 1000,
        "operationsPerThread": 5,
        "delayMs": 20,
        "useVirtualThreads": true,
        "collectMetrics": true
      }
    },
    {
      "id": "database-operations-virtual-task",
      "name": "Database Operations Virtual Thread Test Task",
      "description": "Tests virtual thread performance with database operations",
      "type": "simple",
      "properties": {
        "operationType": "database",
        "operationCount": 500,
        "queryType": "mixed",
        "useVirtualThreads": true,
        "threadPoolSize": 100,
        "collectMetrics": true,
        "detectPinning": true
      }
    },
    {
      "id": "database-operations-platform-task",
      "name": "Database Operations Platform Thread Test Task",
      "description": "Tests platform thread performance with database operations for comparison",
      "type": "simple",
      "properties": {
        "operationType": "database",
        "operationCount": 500,
        "queryType": "mixed",
        "useVirtualThreads": false,
        "threadPoolSize": 100,
        "collectMetrics": true
      }
    },
    {
      "id": "network-operations-virtual-task",
      "name": "Network Operations Virtual Thread Test Task",
      "description": "Tests virtual thread performance with network operations (HTTP/S3)",
      "type": "simple",
      "properties": {
        "operationType": "network",
        "operationCount": 500,
        "requestType": "mixed",
        "useVirtualThreads": true,
        "threadPoolSize": 200,
        "collectMetrics": true,
        "detectPinning": true
      }
    },
    {
      "id": "network-operations-platform-task",
      "name": "Network Operations Platform Thread Test Task",
      "description": "Tests platform thread performance with network operations for comparison",
      "type": "simple",
      "properties": {
        "operationType": "network",
        "operationCount": 500,
        "requestType": "mixed",
        "useVirtualThreads": false,
        "threadPoolSize": 200,
        "collectMetrics": true
      }
    },
    {
      "id": "memory-usage-comparison-task",
      "name": "Memory Usage Comparison Task",
      "description": "Compares memory usage between virtual threads and platform threads",
      "type": "simple",
      "properties": {
        "operationType": "memory",
        "threadCounts": [100, 1000, 10000],
        "runVirtualThreads": true,
        "runPlatformThreads": true,
        "collectMetrics": true,
        "heapDumpEnabled": false
      }
    }
  ]
}