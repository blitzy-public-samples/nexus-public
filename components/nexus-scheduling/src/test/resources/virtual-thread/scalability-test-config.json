{
  "scalabilityTestConfig": {
    "name": "Nexus Scheduling Component Scalability Test",
    "description": "Configuration for testing scalability of the scheduling component using virtual threads compared to platform threads",
    "version": "1.0",
    "testEnvironment": {
      "jvmSettings": {
        "minHeapSize": "1G",
        "maxHeapSize": "4G",
        "gcType": "ZGC",
        "virtualThreadFlags": [
          "-Djdk.tracePinnedThreads=full",
          "-Djdk.virtualThreadScheduler.parallelism=16",
          "-Djdk.virtualThreadScheduler.maxPoolSize=256"
        ],
        "platformThreadFlags": [
          "-XX:+UseZGC",
          "-XX:+ZGenerational"
        ]
      },
      "systemRequirements": {
        "minCpuCores": 4,
        "recommendedCpuCores": 8,
        "minMemoryGb": 8,
        "recommendedMemoryGb": 16,
        "diskSpaceGb": 10
      }
    },
    "loadScenarios": [
      {
        "name": "Low Concurrency",
        "concurrentTasks": 100,
        "taskTypes": [
          {
            "templateId": "io-bound-repository-proxy",
            "weight": 0.5
          },
          {
            "templateId": "io-bound-blob-store",
            "weight": 0.3
          },
          {
            "templateId": "mixed-repository-indexing",
            "weight": 0.2
          }
        ],
        "durationSeconds": 60,
        "warmupSeconds": 15,
        "cooldownSeconds": 15
      },
      {
        "name": "Medium Concurrency",
        "concurrentTasks": 500,
        "taskTypes": [
          {
            "templateId": "io-bound-repository-proxy",
            "weight": 0.4
          },
          {
            "templateId": "io-bound-blob-store",
            "weight": 0.3
          },
          {
            "templateId": "mixed-repository-indexing",
            "weight": 0.2
          },
          {
            "templateId": "io-bound-database",
            "weight": 0.1
          }
        ],
        "durationSeconds": 120,
        "warmupSeconds": 30,
        "cooldownSeconds": 30
      },
      {
        "name": "High Concurrency",
        "concurrentTasks": 1000,
        "taskTypes": [
          {
            "templateId": "io-bound-repository-proxy",
            "weight": 0.4
          },
          {
            "templateId": "io-bound-blob-store",
            "weight": 0.3
          },
          {
            "templateId": "mixed-repository-indexing",
            "weight": 0.2
          },
          {
            "templateId": "io-bound-database",
            "weight": 0.1
          }
        ],
        "durationSeconds": 180,
        "warmupSeconds": 60,
        "cooldownSeconds": 60
      },
      {
        "name": "Very High Concurrency",
        "concurrentTasks": 5000,
        "taskTypes": [
          {
            "templateId": "io-bound-repository-proxy",
            "weight": 0.4
          },
          {
            "templateId": "io-bound-blob-store",
            "weight": 0.3
          },
          {
            "templateId": "mixed-repository-indexing",
            "weight": 0.2
          },
          {
            "templateId": "io-bound-database",
            "weight": 0.1
          }
        ],
        "durationSeconds": 240,
        "warmupSeconds": 60,
        "cooldownSeconds": 60
      },
      {
        "name": "Extreme Concurrency",
        "concurrentTasks": 10000,
        "taskTypes": [
          {
            "templateId": "io-bound-repository-proxy",
            "weight": 0.4
          },
          {
            "templateId": "io-bound-blob-store",
            "weight": 0.3
          },
          {
            "templateId": "mixed-repository-indexing",
            "weight": 0.2
          },
          {
            "templateId": "io-bound-database",
            "weight": 0.1
          }
        ],
        "durationSeconds": 300,
        "warmupSeconds": 90,
        "cooldownSeconds": 90
      }
    ],
    "metricCollection": {
      "samplingIntervalMs": 1000,
      "outputDirectory": "target/scalability-test-results",
      "generateHtmlReport": true,
      "generateCsvData": true,
      "metrics": {
        "thread": {
          "totalThreadCount": true,
          "activeThreadCount": true,
          "threadCreationRate": true,
          "threadTerminationRate": true,
          "pinnedThreadCount": true,
          "pinnedThreadPercentage": true,
          "threadMountingFrequency": true,
          "threadUnmountingFrequency": true,
          "carrierThreadUtilization": true,
          "carrierThreadCount": true
        },
        "performance": {
          "throughput": true,
          "responseTimeAvg": true,
          "responseTimeP50": true,
          "responseTimeP90": true,
          "responseTimeP95": true,
          "responseTimeP99": true,
          "errorRate": true,
          "successRate": true
        },
        "resource": {
          "cpuUtilization": true,
          "systemLoadAverage": true,
          "heapMemoryUsage": true,
          "nonHeapMemoryUsage": true,
          "gcPauseTime": true,
          "gcFrequency": true,
          "threadMemoryOverhead": true,
          "fileDescriptorCount": true,
          "networkBandwidth": true
        }
      }
    },
    "thresholds": {
      "performance": {
        "throughputMinimum": {
          "lowConcurrency": 90,
          "mediumConcurrency": 450,
          "highConcurrency": 900,
          "veryHighConcurrency": 4500,
          "extremeConcurrency": 9000
        },
        "responseTimeP95Maximum": {
          "lowConcurrency": 200,
          "mediumConcurrency": 300,
          "highConcurrency": 400,
          "veryHighConcurrency": 500,
          "extremeConcurrency": 600
        },
        "errorRateMaximum": {
          "lowConcurrency": 0.01,
          "mediumConcurrency": 0.01,
          "highConcurrency": 0.02,
          "veryHighConcurrency": 0.03,
          "extremeConcurrency": 0.05
        }
      },
      "resource": {
        "cpuUtilizationMaximum": 0.85,
        "heapMemoryUsageMaximum": 0.80,
        "gcPauseTimeMaximumMs": 200,
        "threadMemoryOverheadMaximumMb": {
          "virtualThreads": {
            "lowConcurrency": 50,
            "mediumConcurrency": 100,
            "highConcurrency": 150,
            "veryHighConcurrency": 300,
            "extremeConcurrency": 500
          },
          "platformThreads": {
            "lowConcurrency": 100,
            "mediumConcurrency": 300,
            "highConcurrency": 500,
            "veryHighConcurrency": 1500,
            "extremeConcurrency": 3000
          }
        }
      },
      "thread": {
        "pinnedThreadPercentageMaximum": 0.05,
        "carrierThreadUtilizationMaximum": 0.90
      }
    },
    "comparisonConfig": {
      "enabled": true,
      "runWithPlatformThreads": true,
      "runWithVirtualThreads": true,
      "compareMetrics": [
        "throughput",
        "responseTimeP95",
        "threadMemoryOverhead",
        "cpuUtilization",
        "heapMemoryUsage",
        "errorRate"
      ],
      "expectedImprovements": {
        "throughput": {
          "lowConcurrency": 1.1,
          "mediumConcurrency": 1.3,
          "highConcurrency": 1.5,
          "veryHighConcurrency": 2.0,
          "extremeConcurrency": 3.0
        },
        "responseTimeP95": {
          "lowConcurrency": 0.9,
          "mediumConcurrency": 0.8,
          "highConcurrency": 0.7,
          "veryHighConcurrency": 0.6,
          "extremeConcurrency": 0.5
        },
        "threadMemoryOverhead": {
          "lowConcurrency": 0.5,
          "mediumConcurrency": 0.3,
          "highConcurrency": 0.2,
          "veryHighConcurrency": 0.1,
          "extremeConcurrency": 0.05
        }
      }
    },
    "diagnosticConfig": {
      "collectThreadDumps": true,
      "threadDumpIntervalSeconds": 30,
      "collectHeapDumps": false,
      "collectGcLogs": true,
      "collectJfrRecordings": true,
      "jfrSettings": {
        "duration": "whole-test",
        "filename": "scalability-test.jfr",
        "settings": "profile"
      },
      "pinnedThreadDetection": {
        "enabled": true,
        "logStackTraces": true,
        "alertThresholdPercentage": 5.0
      }
    },
    "executionConfig": {
      "threadFactories": {
        "virtualThreadFactory": "Thread.ofVirtual().name(\"vt-task-\", 0).factory()",
        "platformThreadFactory": "Thread.ofPlatform().name(\"pt-task-\", 0).factory()"
      },
      "executorServices": {
        "virtualThreadExecutor": "Executors.newVirtualThreadPerTaskExecutor()",
        "platformThreadExecutor": "Executors.newFixedThreadPool(256, platformThreadFactory)"
      },
      "taskSubmissionRate": {
        "initialRatePerSecond": 10,
        "maxRatePerSecond": 1000,
        "rampUpPeriodSeconds": 30
      },
      "failureHandling": {
        "taskRetryCount": 3,
        "taskRetryDelayMs": 1000,
        "abortOnThresholdViolation": false,
        "continueOnError": true
      }
    }
  }
}