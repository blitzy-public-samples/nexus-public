{
  "modelName": "foo",
  "versionSequence": ["1.0", "1.1", "1.2", "1.3"],
  "availableUpgrades": [
    {
      "from": "1.0",
      "to": "1.1",
      "className": "org.sonatype.nexus.upgrade.gap.UpgradeFoo_1_1"
    },
    {
      "from": "1.2",
      "to": "1.3",
      "className": "org.sonatype.nexus.upgrade.gap.UpgradeFoo_1_3"
    }
  ],
  "testScenarios": [
    {
      "name": "Start from initial version",
      "initialVersion": "1.0",
      "targetVersion": "1.3",
      "expectedPath": ["1.0->1.1", "gap:1.1->1.2", "1.2->1.3"],
      "expectSuccess": false,
      "expectGapError": true
    },
    {
      "name": "Start after first upgrade",
      "initialVersion": "1.1",
      "targetVersion": "1.3",
      "expectedPath": ["gap:1.1->1.2", "1.2->1.3"],
      "expectSuccess": false,
      "expectGapError": true
    },
    {
      "name": "Start at version before final upgrade",
      "initialVersion": "1.2",
      "targetVersion": "1.3",
      "expectedPath": ["1.2->1.3"],
      "expectSuccess": true,
      "expectGapError": false
    },
    {
      "name": "Already at latest version",
      "initialVersion": "1.3",
      "targetVersion": "1.3",
      "expectedPath": [],
      "expectSuccess": true,
      "expectGapError": false
    }
  ],
  "gapHandlingConfig": {
    "allowGaps": false,
    "gapDetectionEnabled": true,
    "gapValidationMode": "STRICT"
  },
  "java21Features": {
    "useVirtualThreads": true,
    "useStructuredConcurrency": true,
    "useRecordPatterns": true
  }
}