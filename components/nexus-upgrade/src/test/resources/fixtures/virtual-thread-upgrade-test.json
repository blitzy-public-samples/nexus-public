    {
      "id": "upgrade-manager-virtual-thread-tests",
      "description": "Test scenarios for UpgradeManager with Virtual Threads",
      "testScenarios": [
        {
          "name": "parallel-database-migrations",
          "description": "Test parallel execution of database migrations with Virtual Threads",
          "concurrencyLevel": 20,
          "migrations": [
            {
              "id": "UPGRADE-VT-001",
              "version": "1.0",
              "description": "Create schema for upgrade testing",
              "sql": "CREATE TABLE upgrade_vt_test (id INTEGER PRIMARY KEY, name VARCHAR(255), status VARCHAR(50))",
              "expectedDuration": 100
            },
            {
              "id": "UPGRADE-VT-002",
              "version": "1.1",
              "description": "Add indexes to upgrade test table",
              "sql": "CREATE INDEX idx_upgrade_vt_name ON upgrade_vt_test(name); CREATE INDEX idx_upgrade_vt_status ON upgrade_vt_test(status)",
              "expectedDuration": 150
            },
            {
              "id": "UPGRADE-VT-003",
              "version": "1.2",
              "description": "Insert test data",
              "sql": "INSERT INTO upgrade_vt_test (id, name, status) VALUES (?, ?, ?)",
              "batchSize": 1000,
              "parameterGenerator": "org.sonatype.nexus.upgrade.virtualthread.TestDataGenerator.generateUpgradeTestData",
              "expectedDuration": 300
            },
            {
              "id": "UPGRADE-VT-004",
              "version": "1.3",
              "description": "Update test data in parallel",
              "sql": "UPDATE upgrade_vt_test SET status = ? WHERE id = ?",
              "batchSize": 1000,
              "parameterGenerator": "org.sonatype.nexus.upgrade.virtualthread.TestDataGenerator.generateStatusUpdates",
              "expectedDuration": 400
            },
            {
              "id": "UPGRADE-VT-005",
              "version": "1.4",
              "description": "Create related table with foreign key",
              "sql": "CREATE TABLE upgrade_vt_related (id INTEGER PRIMARY KEY, test_id INTEGER, metadata TEXT, FOREIGN KEY (test_id) REFERENCES upgrade_vt_test(id))",
              "expectedDuration": 200
            }
          ],
          "expectedResults": {
            "allMigrationsSuccessful": true,
            "maxConcurrentThreads": 20,
            "threadType": "VirtualThread",
            "totalDurationLessThan": 600,
            "tablesCreated": ["upgrade_vt_test", "upgrade_vt_related"],
            "indexesCreated": ["idx_upgrade_vt_name", "idx_upgrade_vt_status"],
            "recordsProcessed": 1000
          }
        },
        {
          "name": "upgrade-manager-implementation-test",
          "description": "Test UpgradeManagerImpl with Virtual Threads",
          "implementation": "org.sonatype.nexus.upgrade.datastore.internal.UpgradeManagerImpl",
          "testMethods": [
            {
              "name": "testNoUpgradesWithVirtualThreads",
              "description": "Test behavior with no upgrades using Virtual Threads",
              "expectedResult": "No migrations applied, no exceptions thrown"
            },
            {
              "name": "testExampleUpgradeWithVirtualThreads",
              "description": "Test example upgrade with Virtual Threads",
              "expectedResult": "Migration applied successfully, events fired correctly"
            },
            {
              "name": "testConcurrentUpgradesWithVirtualThreads",
              "description": "Test concurrent upgrades with Virtual Threads",
              "expectedResult": "All migrations applied successfully in parallel"
            },
            {
              "name": "testUpgradeExceptionHandlingWithVirtualThreads",
              "description": "Test exception handling during upgrades with Virtual Threads",
              "expectedResult": "Exceptions properly propagated and handled"
            }
          ],
          "expectedResults": {
            "allTestsSuccessful": true,
            "threadType": "VirtualThread",
            "performanceImprovement": "Significant improvement for I/O-bound operations"
          }
        }
      ]
    },
    {
      "id": "virtual-thread-compatibility-tests",
      "description": "Test scenarios for compatibility with Virtual Threads",
      "testScenarios": [
        {
          "name": "jdbc-driver-compatibility",
          "description": "Test JDBC driver compatibility with Virtual Threads",
          "drivers": [
            {
              "name": "PostgreSQL JDBC Driver",
              "version": "42.7.2",
              "className": "org.postgresql.Driver",
              "expectedCompatible": true
            },
            {
              "name": "H2 Database Engine",
              "version": "2.2.224",
              "className": "org.h2.Driver",
              "expectedCompatible": true
            }
          ],
          "operations": [
            {
              "name": "executeQuery",
              "sql": "SELECT 1",
              "concurrentExecutions": 100,
              "expectedSuccessRate": 100
            },
            {
              "name": "executeBatchUpdate",
              "sql": "INSERT INTO vt_compat_test VALUES (?, ?)",
              "batchSize": 1000,
              "concurrentExecutions": 50,
              "expectedSuccessRate": 100
            },
            {
              "name": "executeTransaction",
              "description": "Execute a complete transaction with multiple statements",
              "concurrentExecutions": 25,
              "expectedSuccessRate": 100
            }
          ],
          "expectedResults": {
            "allDriversCompatible": true,
            "allOperationsSuccessful": true,
            "performanceImprovement": "3x-5x compared to platform threads"
          }
