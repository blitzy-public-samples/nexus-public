{
  "virtualThreadTestFixtures": [
    {
      "id": "concurrent-upgrade-operations",
      "description": "Test scenarios for running multiple upgrade operations concurrently using Virtual Threads",
      "testScenarios": [
        {
          "name": "basic-concurrent-migrations",
          "description": "Basic test for concurrent execution of multiple database migrations",
          "concurrencyLevel": 10,
          "migrations": [
            {
              "id": "VT-MIGRATION-001",
              "version": "1.0",
              "description": "Create test table for virtual thread testing",
              "sql": "CREATE TABLE vt_test_table (id INTEGER PRIMARY KEY, name VARCHAR(255), created_at TIMESTAMP)",
              "expectedDuration": 100
            },
            {
              "id": "VT-MIGRATION-002",
              "version": "1.1",
              "description": "Add index to test table",
              "sql": "CREATE INDEX idx_vt_test_name ON vt_test_table(name)",
              "expectedDuration": 150
            },
            {
              "id": "VT-MIGRATION-003",
              "version": "1.2",
              "description": "Add additional columns to test table",
              "sql": "ALTER TABLE vt_test_table ADD COLUMN description TEXT, ADD COLUMN updated_at TIMESTAMP",
              "expectedDuration": 200
            },
            {
              "id": "VT-MIGRATION-004",
              "version": "1.3",
              "description": "Create secondary test table with foreign key",
              "sql": "CREATE TABLE vt_test_related (id INTEGER PRIMARY KEY, test_id INTEGER, data TEXT, FOREIGN KEY (test_id) REFERENCES vt_test_table(id))",
              "expectedDuration": 180
            },
            {
              "id": "VT-MIGRATION-005",
              "version": "1.4",
              "description": "Add index to secondary table",
              "sql": "CREATE INDEX idx_vt_test_related_test_id ON vt_test_related(test_id)",
              "expectedDuration": 120
            }
          ],
          "expectedResults": {
            "allMigrationsSuccessful": true,
            "maxConcurrentThreads": 10,
            "threadType": "VirtualThread",
            "totalDurationLessThan": 400,
            "tablesCreated": ["vt_test_table", "vt_test_related"],
            "indexesCreated": ["idx_vt_test_name", "idx_vt_test_related_test_id"]
          }
        },
        {
          "name": "high-concurrency-data-migrations",
          "description": "Test for high concurrency with data insertion and updates",
          "concurrencyLevel": 100,
          "migrations": [
            {
              "id": "VT-DATA-MIGRATION-001",
              "version": "2.0",
              "description": "Create data table for high concurrency testing",
              "sql": "CREATE TABLE vt_high_concurrency (id INTEGER PRIMARY KEY, data VARCHAR(255), processed BOOLEAN DEFAULT FALSE)",
              "expectedDuration": 100
            },
            {
              "id": "VT-DATA-MIGRATION-002",
              "version": "2.1",
              "description": "Insert initial test data",
              "sql": "INSERT INTO vt_high_concurrency (id, data) VALUES (?, ?)",
              "batchSize": 1000,
              "parameterGenerator": "org.sonatype.nexus.upgrade.virtualthread.TestDataGenerator.generateRandomData",
              "expectedDuration": 500
            },
            {
              "id": "VT-DATA-MIGRATION-003",
              "version": "2.2",
              "description": "Update data in parallel",
              "sql": "UPDATE vt_high_concurrency SET processed = TRUE, data = ? WHERE id = ?",
              "batchSize": 1000,
              "parameterGenerator": "org.sonatype.nexus.upgrade.virtualthread.TestDataGenerator.generateUpdatedData",
              "expectedDuration": 800
            },
            {
              "id": "VT-DATA-MIGRATION-004",
              "version": "2.3",
              "description": "Verify all data was processed",
              "sql": "SELECT COUNT(*) FROM vt_high_concurrency WHERE processed = FALSE",
              "expectedResult": 0,
              "expectedDuration": 200
            }
          ],
          "expectedResults": {
            "allMigrationsSuccessful": true,
            "maxConcurrentThreads": 100,
            "threadType": "VirtualThread",
            "totalDurationLessThan": 1000,
            "recordsProcessed": 1000,
            "tablesCreated": ["vt_high_concurrency"]
          }
        }
      ]
    },
    {
      "id": "thread-pinning-detection",
      "description": "Test scenarios to detect and mitigate thread pinning issues",
      "testScenarios": [
        {
          "name": "synchronization-pinning-detection",
          "description": "Test detection of thread pinning due to synchronization",
          "concurrencyLevel": 20,
          "pinningScenarios": [
            {
              "id": "PINNING-TEST-001",
              "description": "Synchronized method causing thread pinning",
              "className": "org.sonatype.nexus.upgrade.virtualthread.ThreadPinningTest",
              "methodName": "synchronizedMethodCausingPinning",
              "expectedPinningDetected": true,
              "expectedWarningMessage": "Thread pinning detected in synchronizedMethodCausingPinning"
            },
            {
              "id": "PINNING-TEST-002",
              "description": "Synchronized block causing thread pinning",
              "className": "org.sonatype.nexus.upgrade.virtualthread.ThreadPinningTest",
              "methodName": "synchronizedBlockCausingPinning",
              "expectedPinningDetected": true,
              "expectedWarningMessage": "Thread pinning detected in synchronizedBlockCausingPinning"
            },
            {
              "id": "PINNING-TEST-003",
              "description": "Lock-based synchronization without pinning",
              "className": "org.sonatype.nexus.upgrade.virtualthread.ThreadPinningTest",
              "methodName": "lockBasedSynchronizationWithoutPinning",
              "expectedPinningDetected": false
            }
          ],
          "expectedResults": {
            "pinningDetectionSuccessful": true,
            "pinningIssuesDetected": 2,
            "pinningMitigationApplied": true
          }
        },
        {
          "name": "blocking-io-pinning-detection",
          "description": "Test detection of thread pinning due to blocking I/O operations",
          "concurrencyLevel": 50,
          "pinningScenarios": [
            {
              "id": "IO-PINNING-TEST-001",
              "description": "Blocking file I/O causing thread pinning",
              "className": "org.sonatype.nexus.upgrade.virtualthread.IOPinningTest",
              "methodName": "blockingFileIOCausingPinning",
              "expectedPinningDetected": true,
              "expectedWarningMessage": "Thread pinning detected in blockingFileIOCausingPinning"
            },
            {
              "id": "IO-PINNING-TEST-002",
              "description": "Non-virtual thread JDBC operations causing pinning",
              "className": "org.sonatype.nexus.upgrade.virtualthread.IOPinningTest",
              "methodName": "nonVirtualThreadJdbcOperations",
              "expectedPinningDetected": true,
              "expectedWarningMessage": "Thread pinning detected in nonVirtualThreadJdbcOperations"
            },
            {
              "id": "IO-PINNING-TEST-003",
              "description": "Virtual thread compatible JDBC operations",
              "className": "org.sonatype.nexus.upgrade.virtualthread.IOPinningTest",
              "methodName": "virtualThreadCompatibleJdbcOperations",
              "expectedPinningDetected": false
            }
          ],
          "expectedResults": {
            "pinningDetectionSuccessful": true,
            "pinningIssuesDetected": 2,
            "pinningMitigationApplied": true,
            "performanceImprovementAfterMitigation": "50%"
          }
        }
      ]
    },
    {
      "id": "io-bound-operations",
      "description": "Test scenarios for I/O-bound operations that would benefit from Virtual Threads",
      "testScenarios": [
        {
          "name": "database-io-operations",
          "description": "Test database I/O operations with Virtual Threads",
          "concurrencyLevel": 200,
          "operations": [
            {
              "id": "DB-IO-TEST-001",
              "description": "Bulk data insertion with Virtual Threads",
              "className": "org.sonatype.nexus.upgrade.virtualthread.DatabaseIOTest",
              "methodName": "bulkDataInsertionWithVirtualThreads",
              "parameters": {
                "recordCount": 10000,
                "batchSize": 100
              },
              "expectedDuration": 2000
            },
            {
              "id": "DB-IO-TEST-002",
              "description": "Parallel query execution with Virtual Threads",
              "className": "org.sonatype.nexus.upgrade.virtualthread.DatabaseIOTest",
              "methodName": "parallelQueryExecutionWithVirtualThreads",
              "parameters": {
                "queryCount": 1000,
                "complexity": "medium"
              },
              "expectedDuration": 1500
            },
            {
              "id": "DB-IO-TEST-003",
              "description": "Schema migration with Virtual Threads",
              "className": "org.sonatype.nexus.upgrade.virtualthread.DatabaseIOTest",
              "methodName": "schemaMigrationWithVirtualThreads",
              "parameters": {
                "migrationCount": 50,
                "tablesPerMigration": 2
              },
              "expectedDuration": 3000
            }
          ],
          "expectedResults": {
            "allOperationsSuccessful": true,
