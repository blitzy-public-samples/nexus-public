{
  "_comment": "Test fixture for validating the Nexus upgrade framework's compatibility with Java 21 Virtual Threads",
  "models": [
    {
      "name": "database",
      "currentVersion": "1.0",
      "targetVersion": "2.0",
      "upgradePaths": [
        {
          "from": "1.0",
          "to": "1.5",
          "upgradeClass": "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_1_5",
          "ioOperations": [
            {
              "type": "schema",
              "description": "Create tables for virtual thread testing",
              "estimatedDuration": 150
            }
          ]
        },
        {
          "from": "1.5",
          "to": "2.0",
          "upgradeClass": "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_2_0",
          "ioOperations": [
            {
              "type": "data",
              "description": "Insert test data in parallel",
              "estimatedDuration": 300,
              "parallelOperations": 1000
            }
          ]
        }
      ],
      "metadata": {
        "description": "Database schema and data upgrades for virtual thread testing",
        "priority": "high",
        "ioIntensive": true
      }
    },
    {
      "name": "blobstore",
      "currentVersion": "1.0",
      "targetVersion": "1.5",
      "upgradePaths": [
        {
          "from": "1.0",
          "to": "1.5",
          "upgradeClass": "org.sonatype.nexus.upgrade.virtualthread.UpgradeBlobstore_1_5",
          "dependencies": [
            {
              "model": "database",
              "version": "1.5"
            }
          ],
          "ioOperations": [
            {
              "type": "file",
              "description": "Migrate blob metadata files",
              "estimatedDuration": 500,
              "parallelOperations": 200
            }
          ]
        }
      ],
      "metadata": {
        "description": "Blobstore upgrades with heavy file I/O operations",
        "priority": "medium",
        "ioIntensive": true
      }
    },
    {
      "name": "repository",
      "currentVersion": "1.0",
      "targetVersion": "1.5",
      "upgradePaths": [
        {
          "from": "1.0",
          "to": "1.5",
          "upgradeClass": "org.sonatype.nexus.upgrade.virtualthread.UpgradeRepository_1_5",
          "dependencies": [
            {
              "model": "database",
              "version": "2.0"
            },
            {
              "model": "blobstore",
              "version": "1.5"
            }
          ],
          "ioOperations": [
            {
              "type": "mixed",
              "description": "Comprehensive repository upgrade with database, file, and network operations",
              "estimatedDuration": 1000,
              "parallelOperations": 100
            }
          ]
        }
      ],
      "metadata": {
        "description": "Repository configuration upgrades",
        "priority": "low",
        "ioIntensive": true
      }
    }
  ],
  "upgradeConfiguration": {
    "executionMode": "parallel",
    "failFast": true,
    "maxRetries": 3,
    "retryDelayMillis": 1000,
    "logLevel": "INFO",
    "java21Features": {
      "useVirtualThreads": true,
      "virtualThreadConfiguration": {
        "maxConcurrentOperations": 1000,
        "schedulerParallelism": 16,
        "pinningDetectionEnabled": true,
        "pinningThresholdMillis": 100
      },
      "usePatternMatching": true,
      "useStringTemplates": true,
      "useRecordPatterns": true
    },
    "performanceMetrics": {
      "enabled": true,
      "compareWithPlatformThreads": true,
      "collectMemoryMetrics": true,
      "collectCpuMetrics": true,
      "collectThreadMetrics": true,
      "outputFile": "virtual-thread-upgrade-metrics.json"
    }
  },
  "testScenarios": [
    {
      "name": "Complete upgrade sequence",
      "description": "Tests the full upgrade sequence with all dependencies using virtual threads",
      "expectedExecutionOrder": [
        "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_1_5",
        "org.sonatype.nexus.upgrade.virtualthread.UpgradeBlobstore_1_5",
        "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_2_0",
        "org.sonatype.nexus.upgrade.virtualthread.UpgradeRepository_1_5"
      ],
      "expectedPerformance": {
        "totalDurationLessThan": 2000,
        "speedupVsPlatformThreads": "3x-5x",
        "maxConcurrentVirtualThreads": 1000,
        "maxConcurrentPlatformThreads": 16
      }
    },
    {
      "name": "Database-only upgrade",
      "description": "Tests upgrading only the database model with virtual threads",
      "modelsToUpgrade": ["database"],
      "expectedExecutionOrder": [
        "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_1_5",
        "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_2_0"
      ],
      "expectedPerformance": {
        "totalDurationLessThan": 500,
        "speedupVsPlatformThreads": "2x-3x",
        "maxConcurrentVirtualThreads": 1000,
        "maxConcurrentPlatformThreads": 16
      }
    },
    {
      "name": "Parallel independent upgrades",
      "description": "Tests parallel execution of independent upgrade steps using virtual threads",
      "modelsToUpgrade": ["database", "blobstore"],
      "expectedParallelExecution": [
        ["org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_1_5"],
        ["org.sonatype.nexus.upgrade.virtualthread.UpgradeBlobstore_1_5", "org.sonatype.nexus.upgrade.virtualthread.UpgradeDatabase_2_0"]
      ],
      "expectedPerformance": {
        "totalDurationLessThan": 800,
        "speedupVsPlatformThreads": "2x-4x",
        "maxConcurrentVirtualThreads": 500,
        "maxConcurrentPlatformThreads": 16
      }
    }
  ],
  "virtualThreadTests": {
    "threadPinningTests": [
      {
        "name": "Database operations pinning detection",
        "description": "Tests detection of thread pinning during database operations",
        "testClass": "org.sonatype.virtualthread.VirtualThreadDatabaseMigrationTest",
        "testMethod": "testDatabaseOperationPinning",
        "expectedResult": "Pinning detected and mitigated",
        "pinningScenarios": [
          {
            "operation": "JDBC batch insert",
            "expectedPinningDuration": 50,
            "mitigationStrategy": "Use non-blocking JDBC driver"
          },
          {
            "operation": "Database lock acquisition",
            "expectedPinningDuration": 75,
            "mitigationStrategy": "Use timeout and retry mechanism"
          },
          {
            "operation": "Transaction commit",
            "expectedPinningDuration": 30,
            "mitigationStrategy": "Optimize transaction size"
          }
        ]
      },
      {
        "name": "File I/O pinning detection",
        "description": "Tests detection of thread pinning during file I/O operations",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testFileIOPinning",
        "expectedResult": "Pinning detected and mitigated",
        "pinningScenarios": [
          {
            "operation": "Large file read",
            "expectedPinningDuration": 120,
            "mitigationStrategy": "Use buffered async I/O"
          },
          {
            "operation": "Metadata index update",
            "expectedPinningDuration": 80,
            "mitigationStrategy": "Batch updates"
          },
          {
            "operation": "File system synchronization",
            "expectedPinningDuration": 150,
            "mitigationStrategy": "Defer synchronization"
          }
        ]
      },
      {
        "name": "Synchronization pinning detection",
        "description": "Tests detection of thread pinning due to synchronization",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testSynchronizationPinning",
        "expectedResult": "Pinning detected and mitigated",
        "pinningScenarios": [
          {
            "operation": "Shared resource access",
            "expectedPinningDuration": 60,
            "mitigationStrategy": "Use concurrent data structures"
          },
          {
            "operation": "Global lock acquisition",
            "expectedPinningDuration": 90,
            "mitigationStrategy": "Use finer-grained locking"
          },
          {
            "operation": "Thread coordination",
            "expectedPinningDuration": 40,
            "mitigationStrategy": "Use structured concurrency"
          }
        ]
      }
    ],
    "performanceTests": [
      {
        "name": "Database operations performance",
        "description": "Tests performance of database operations with virtual threads",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testDatabaseOperationPerformance",
        "parameters": {
          "operationCount": 10000,
          "virtualThreads": true,
          "operationTypes": ["select", "insert", "update", "delete"],
          "concurrencyLevels": [10, 100, 1000, 10000]
        },
        "expectedResult": "Virtual threads outperform platform threads by at least 3x",
        "metrics": [
          {
            "name": "throughput",
            "unit": "operations/second",
            "expectedImprovement": "300%"
          },
          {
            "name": "latency",
            "unit": "milliseconds",
            "expectedImprovement": "70%"
          },
          {
            "name": "resourceUtilization",
            "unit": "percent",
            "expectedImprovement": "50%"
          }
        ]
      },
      {
        "name": "File I/O performance",
        "description": "Tests performance of file I/O operations with virtual threads",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testFileIOPerformance",
        "parameters": {
          "fileCount": 1000,
          "fileSize": "1MB",
          "virtualThreads": true,
          "operationTypes": ["read", "write", "copy", "delete"],
          "concurrencyLevels": [10, 100, 1000]
        },
        "expectedResult": "Virtual threads outperform platform threads by at least 2x",
        "metrics": [
          {
            "name": "throughput",
            "unit": "files/second",
            "expectedImprovement": "200%"
          },
          {
            "name": "latency",
            "unit": "milliseconds",
            "expectedImprovement": "60%"
          },
          {
            "name": "resourceUtilization",
            "unit": "percent",
            "expectedImprovement": "40%"
          }
        ]
      },
      {
        "name": "Network I/O performance",
        "description": "Tests performance of network I/O operations with virtual threads",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testNetworkIOPerformance",
        "parameters": {
          "requestCount": 500,
          "virtualThreads": true,
          "operationTypes": ["http", "https", "socket"],
          "concurrencyLevels": [10, 100, 500]
        },
        "expectedResult": "Virtual threads outperform platform threads by at least 5x",
        "metrics": [
          {
            "name": "throughput",
            "unit": "requests/second",
            "expectedImprovement": "500%"
          },
          {
            "name": "latency",
            "unit": "milliseconds",
            "expectedImprovement": "80%"
          },
          {
            "name": "resourceUtilization",
            "unit": "percent",
            "expectedImprovement": "70%"
          }
        ]
      }
    ],
    "compatibilityTests": [
      {
        "name": "JDBC driver compatibility",
        "description": "Tests compatibility of JDBC drivers with virtual threads",
        "testClass": "org.sonatype.virtualthread.VirtualThreadDatabaseMigrationTest",
        "testMethod": "testJdbcDriverCompatibility",
        "drivers": [
          {
            "name": "PostgreSQL JDBC Driver",
            "version": "42.7.2",
            "expectedCompatible": true,
            "knownIssues": []
          },
          {
            "name": "H2 Database Engine",
            "version": "2.2.224",
            "expectedCompatible": true,
            "knownIssues": []
          }
        ]
      },
      {
        "name": "Third-party library compatibility",
        "description": "Tests compatibility of third-party libraries with virtual threads",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testThirdPartyLibraryCompatibility",
        "libraries": [
          {
            "name": "Apache Shiro",
            "version": "1.13.0",
            "expectedCompatible": true,
            "knownIssues": [
              "Thread-local session management may cause pinning"
            ]
          },
          {
            "name": "Google Guice",
            "version": "6.0.0",
            "expectedCompatible": true,
            "knownIssues": []
          },
          {
            "name": "MyBatis",
            "version": "3.5.15",
            "expectedCompatible": true,
            "knownIssues": [
              "Connection pooling may cause pinning if not configured properly"
            ]
          }
        ]
      }
    ],
    "scalabilityTests": [
      {
        "name": "Concurrent upgrade operations",
        "description": "Tests scalability of upgrade operations with increasing concurrency",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testConcurrentUpgradeOperations",
        "concurrencyLevels": [10, 100, 1000, 10000],
        "expectedResults": [
          {
            "concurrencyLevel": 10,
            "platformThreadThroughput": "baseline",
            "virtualThreadThroughput": "1.5x baseline"
          },
          {
            "concurrencyLevel": 100,
            "platformThreadThroughput": "0.8x baseline",
            "virtualThreadThroughput": "2.5x baseline"
          },
          {
            "concurrencyLevel": 1000,
            "platformThreadThroughput": "0.5x baseline",
            "virtualThreadThroughput": "4x baseline"
          },
          {
            "concurrencyLevel": 10000,
            "platformThreadThroughput": "0.3x baseline",
            "virtualThreadThroughput": "5x baseline"
          }
        ]
      },
      {
        "name": "Memory footprint comparison",
        "description": "Tests memory usage of platform threads vs virtual threads",
        "testClass": "org.sonatype.virtualthread.VirtualThreadPerformanceComparisonTest",
        "testMethod": "testMemoryFootprint",
        "threadCounts": [100, 1000, 10000],
        "expectedResults": [
          {
            "threadCount": 100,
            "platformThreadMemory": "baseline",
            "virtualThreadMemory": "0.2x baseline"
          },
          {
            "threadCount": 1000,
            "platformThreadMemory": "10x baseline",
            "virtualThreadMemory": "0.3x baseline"
          },
          {
            "threadCount": 10000,
            "platformThreadMemory": "100x baseline",
            "virtualThreadMemory": "0.5x baseline"
          }
        ]
      }
    ]
  },
  "checkpoints": {
    "enabled": true,
    "interval": 1000,
    "persistLocation": "upgrade-checkpoints.json",
    "validateOnRestart": true
  },
  "extensionPoints": {
    "preUpgradeHooks": [
      {
        "name": "VirtualThreadSetup",
        "description": "Configures virtual thread execution environment",
        "hookClass": "org.sonatype.virtualthread.VirtualThreadSetupHook"
      },
      {
        "name": "PerformanceMonitoringStart",
        "description": "Starts performance monitoring for the upgrade process",
        "hookClass": "org.sonatype.virtualthread.PerformanceMonitoringHook"
      }
    ],
    "postUpgradeHooks": [
      {
        "name": "PerformanceReport",
        "description": "Generates performance report comparing virtual threads to platform threads",
        "hookClass": "org.sonatype.virtualthread.PerformanceReportHook"
      },
      {
        "name": "ThreadPinningReport",
        "description": "Generates report on thread pinning incidents during upgrade",
        "hookClass": "org.sonatype.virtualthread.ThreadPinningReportHook"
      }
    ],
    "errorHandlers": [
      {
        "name": "VirtualThreadErrorHandler",
        "description": "Handles errors specific to virtual thread execution",
        "handlerClass": "org.sonatype.virtualthread.VirtualThreadErrorHandler"
      }
    ]
  }
}