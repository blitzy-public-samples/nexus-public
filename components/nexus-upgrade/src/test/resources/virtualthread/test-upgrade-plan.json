{
  "metadata": {
    "planId": "virtual-thread-test-plan",
    "description": "Test upgrade plan for validating virtual thread execution",
    "createdAt": "2024-05-24T10:00:00Z",
    "targetVersion": "3.76.0",
    "sourceVersion": "3.71.0",
    "executionMode": "VIRTUAL_THREAD"
  },
  "configuration": {
    "virtualThreadEnabled": true,
    "maxConcurrentSteps": 10,
    "timeoutSeconds": 300,
    "retryCount": 3,
    "retryDelaySeconds": 5,
    "collectPerformanceMetrics": true,
    "checkpointAfterEachStep": true
  },
  "steps": [
    {
      "id": "initialize-upgrade",
      "description": "Initialize the upgrade process",
      "type": "INITIALIZATION",
      "dependencies": [],
      "parameters": {
        "validateSystemRequirements": true,
        "backupConfiguration": true
      },
      "expectedDurationMs": 5000,
      "checkpoint": {
        "enabled": true,
        "data": {
          "status": "INITIALIZED",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "backup-database-schema",
      "description": "Create a backup of the database schema",
      "type": "DATABASE_OPERATION",
      "dependencies": ["initialize-upgrade"],
      "parameters": {
        "operation": "BACKUP",
        "target": "SCHEMA",
        "location": "${DATA_DIR}/backup/schema_${TIMESTAMP}.sql"
      },
      "expectedDurationMs": 15000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "backupLocation": "${DATA_DIR}/backup/schema_${TIMESTAMP}.sql",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "backup-blobstore-metadata",
      "description": "Backup BlobStore metadata",
      "type": "FILE_OPERATION",
      "dependencies": ["initialize-upgrade"],
      "parameters": {
        "operation": "BACKUP",
        "source": "${DATA_DIR}/blobs",
        "destination": "${DATA_DIR}/backup/blobs_${TIMESTAMP}",
        "includePatterns": ["**/*.properties", "**/*.json", "**/*.xml"],
        "excludePatterns": ["**/tmp/**"]
      },
      "expectedDurationMs": 20000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "backupLocation": "${DATA_DIR}/backup/blobs_${TIMESTAMP}",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "update-database-schema",
      "description": "Update database schema to support Java 21 features",
      "type": "DATABASE_OPERATION",
      "dependencies": ["backup-database-schema"],
      "parameters": {
        "operation": "MIGRATE",
        "scripts": [
          "upgrade/3.71.0_to_3.76.0/01_add_virtual_thread_metrics_table.sql",
          "upgrade/3.71.0_to_3.76.0/02_add_thread_execution_indexes.sql",
          "upgrade/3.71.0_to_3.76.0/03_update_schema_version.sql"
        ],
        "validateAfterEach": true
      },
      "expectedDurationMs": 30000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "schemaVersion": "3.76.0",
          "migrationsApplied": 3,
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "update-configuration-files",
      "description": "Update configuration files for Java 21 compatibility",
      "type": "FILE_OPERATION",
      "dependencies": ["initialize-upgrade"],
      "parameters": {
        "operation": "UPDATE",
        "files": [
          {
            "path": "${INSTALL_DIR}/etc/jetty/jetty.xml",
            "updates": [
              {
                "type": "REPLACE",
                "pattern": "<Set name=\"maxThreads\">400</Set>",
                "replacement": "<Set name=\"maxThreads\">256</Set>"
              },
              {
                "type": "ADD",
                "after": "<Set name=\"maxThreads\">256</Set>",
                "content": "<Set name=\"virtualThreadsEnabled\">true</Set>"
              }
            ]
          },
          {
            "path": "${INSTALL_DIR}/bin/nexus.vmoptions",
            "updates": [
              {
                "type": "ADD",
                "after": "-XX:+UseZGC",
                "content": "-XX:+ZGenerational"
              },
              {
                "type": "ADD",
                "after": "-Xms2703m",
                "content": "-Djdk.virtualThreadScheduler.parallelism=16\n-Djdk.virtualThreadScheduler.maxPoolSize=256"
              }
            ]
          }
        ]
      },
      "expectedDurationMs": 10000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "updatedFiles": 2,
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "update-thread-pool-configuration",
      "description": "Update thread pool configuration for virtual threads",
      "type": "DATABASE_OPERATION",
      "dependencies": ["update-database-schema"],
      "parameters": {
        "operation": "EXECUTE",
        "statements": [
          "UPDATE system_configuration SET value = 'VIRTUAL' WHERE key = 'threadPoolType'",
          "UPDATE system_configuration SET value = '256' WHERE key = 'maxThreads'",
          "INSERT INTO system_configuration (key, value) VALUES ('virtualThreadsEnabled', 'true')"
        ]
      },
      "expectedDurationMs": 5000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "threadPoolType": "VIRTUAL",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "migrate-repository-configurations",
      "description": "Update repository configurations for Java 21 compatibility",
      "type": "DATABASE_OPERATION",
      "dependencies": ["update-thread-pool-configuration"],
      "parameters": {
        "operation": "EXECUTE",
        "statements": [
          "UPDATE repository_config SET attributes = jsonb_set(attributes, '{httpClient,virtualThreads}', 'true') WHERE recipe_name LIKE '%proxy'"
        ]
      },
      "expectedDurationMs": 15000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "repositoriesUpdated": "${AFFECTED_ROWS}",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "optimize-blobstore-for-virtual-threads",
      "description": "Optimize BlobStore operations for virtual threads",
      "type": "COMPONENT_OPERATION",
      "dependencies": ["backup-blobstore-metadata", "update-configuration-files"],
      "parameters": {
        "component": "blobstore",
        "operation": "OPTIMIZE",
        "options": {
          "enableVirtualThreads": true,
          "optimizeForIo": true,
          "batchSize": 100
        }
      },
      "expectedDurationMs": 45000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "blobstoresOptimized": "${AFFECTED_COMPONENTS}",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "update-http-client-configuration",
      "description": "Update HTTP client configuration for virtual threads",
      "type": "COMPONENT_OPERATION",
      "dependencies": ["update-configuration-files"],
      "parameters": {
        "component": "httpclient",
        "operation": "UPDATE_CONFIG",
        "options": {
          "enableVirtualThreads": true,
          "disableThreadPool": true,
          "useDirectExecutor": true
        }
      },
      "expectedDurationMs": 5000,
      "ioIntensive": false,
      "checkpoint": {
        "enabled": true,
        "data": {
          "status": "UPDATED",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "verify-database-connections",
      "description": "Verify database connections with virtual threads",
      "type": "VERIFICATION",
      "dependencies": ["update-database-schema", "update-thread-pool-configuration"],
      "parameters": {
        "operation": "TEST_CONNECTIONS",
        "connectionCount": 100,
        "concurrentConnections": 50,
        "testDurationSeconds": 10
      },
      "expectedDurationMs": 15000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "connectionsSuccessful": "${SUCCESS_COUNT}",
          "connectionsFailed": "${FAILURE_COUNT}",
          "averageResponseTimeMs": "${AVG_RESPONSE_TIME}",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "verify-repository-operations",
      "description": "Verify repository operations with virtual threads",
      "type": "VERIFICATION",
      "dependencies": ["migrate-repository-configurations", "optimize-blobstore-for-virtual-threads"],
      "parameters": {
        "operation": "TEST_REPOSITORIES",
        "repositoryTypes": ["maven", "npm", "docker"],
        "operationsPerRepository": 50,
        "concurrentOperations": 30
      },
      "expectedDurationMs": 30000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "repositoriesTested": "${TESTED_COUNT}",
          "operationsSuccessful": "${SUCCESS_COUNT}",
          "operationsFailed": "${FAILURE_COUNT}",
          "averageResponseTimeMs": "${AVG_RESPONSE_TIME}",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "collect-performance-metrics",
      "description": "Collect performance metrics for virtual thread execution",
      "type": "METRICS_COLLECTION",
      "dependencies": ["verify-database-connections", "verify-repository-operations"],
      "parameters": {
        "metrics": ["threadCount", "memoryUsage", "cpuUsage", "responseTime", "throughput"],
        "duration": 30,
        "intervalSeconds": 5,
        "outputFile": "${DATA_DIR}/upgrade/metrics_${TIMESTAMP}.json"
      },
      "expectedDurationMs": 35000,
      "ioIntensive": false,
      "checkpoint": {
        "enabled": true,
        "data": {
          "metricsCollected": 5,
          "samplesCollected": 6,
          "outputFile": "${DATA_DIR}/upgrade/metrics_${TIMESTAMP}.json",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    },
    {
      "id": "finalize-upgrade",
      "description": "Finalize the upgrade process",
      "type": "FINALIZATION",
      "dependencies": ["collect-performance-metrics"],
      "parameters": {
        "updateVersionInfo": true,
        "cleanupTempFiles": true,
        "generateReport": true,
        "reportFile": "${DATA_DIR}/upgrade/report_${TIMESTAMP}.html"
      },
      "expectedDurationMs": 10000,
      "ioIntensive": true,
      "checkpoint": {
        "enabled": true,
        "data": {
          "status": "COMPLETED",
          "newVersion": "3.76.0",
          "upgradeTime": "${TOTAL_EXECUTION_TIME}",
          "timestamp": "${EXECUTION_TIME}"
        }
      }
    }
  ]
}