{
  "name": "@sonatype/nexus-coreui-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm-run-all --parallel build-dev build-prod",
    "build-all": "npm-run-all build-dev build-prod",
    "build-dev": "webpack --config webpack.dev.js",
    "build-prod": "webpack --config webpack.prod.js",
    "test": "jest --config src/frontend/jest.config.js",
    "test-coverage": "jest --config src/frontend/jest.config.js --coverage",
    "test-watch": "jest --config src/frontend/jest.config.js --watch",
    "test-watch-debug": "node --inspect-brk node_modules/.bin/jest --config src/frontend/jest.config.js --runInBand --watchAll",
    "watch": "webpack --config webpack.dev.js  --watch"
  },
  "dependencies": {
    "@babel/runtime": "7.23.9",
    "@fortawesome/fontawesome-svg-core": "6.5.1",
    "@fortawesome/free-brands-svg-icons": "6.5.1",
    "@fortawesome/free-solid-svg-icons": "6.5.1",
    "@nivo/core": "^0.85.0",
    "@nivo/line": "^0.85.0",
    "@sonatype/react-shared-components": "13.1.6",
    "@xstate/react": "3.2.2",
    "axios": "1.6.7",
    "classnames": "2.5.1",
    "luxon": "3.4.4",
    "ramda": "0.29.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "swagger-ui-react": "5.11.8",
    "xstate": "4.38.3"
  },
  "devDependencies": {
    "@babel/core": "7.23.9",
    "@babel/plugin-proposal-export-default-from": "7.23.3",
    "@babel/plugin-proposal-optional-chaining": "7.21.0",
    "@babel/plugin-transform-runtime": "7.23.9",
    "@babel/preset-env": "7.23.9",
    "@babel/preset-react": "7.23.3",
    "@sonatype/nexus-ui-plugin": "workspace:*",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.1",
    "@testing-library/user-event": "14.5.2",
    "acorn": "8.11.3",
    "babel-jest": "29.7.0",
    "babel-loader": "9.1.3",
    "copy-modules-webpack-plugin": "2.2.1",
    "css-loader": "6.10.0",
    "css-minimizer-webpack-plugin": "5.0.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-when": "3.6.0",
    "mini-css-extract-plugin": "2.8.0",
    "npm-run-all": "4.1.5",
    "prop-types": "15.8.1",
    "sass": "1.70.0",
    "sass-loader": "14.1.0",
    "terser-webpack-plugin": "5.3.10",
    "webpack": "5.90.1",
    "webpack-cli": "5.1.4",
    "webpack-merge": "5.10.0"
  },
  "jest-junit": {
    "outputDirectory": "target/jest-reports",
    "outputName": "TEST-react-jest.xml",
    "reportTestSuiteErrors": true
  }
}