/*
 * Elasticsearch mapping for Maven repository components
 * Updated for Java 21 compatibility:
 * - Replaced deprecated "type": "string" with "type": "keyword" for non-analyzed fields
 * - Replaced deprecated "type": "string" with "type": "text" for analyzed fields
 * - Removed deprecated "index": "not_analyzed" setting (keyword type implies not_analyzed)
 */
{
  "settings": {
    "analysis": {
      "analyzer": {
        "paths": {
          "tokenizer": "path_hierarchy"
        }
      }
    }
  },
  "mappings": {
    "component": {
      "dynamic_templates": [
        {
          "dates": {
            "match_mapping_type": "date",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "attributes.maven2": {
            "path_match": "attributes.maven2.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        },
        {
          "assets.attributes.maven2": {
            "path_match": "assets.attributes.maven2.*",
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        }
      ],
      "properties": {
        "assets": {
          "properties": {
            "attributes": {
              "properties": {
                "maven2": {
                  "properties": {
                    "path": {
                      "type": "keyword",
                      "fields": {
                        "tree": {
                          "type": "text",
                          "analyzer": "paths"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}