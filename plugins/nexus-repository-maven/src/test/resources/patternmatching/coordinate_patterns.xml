<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file contains various Maven coordinate patterns for testing Java 21's record pattern matching.
  It provides test fixtures to validate that pattern matching correctly identifies and processes
  different coordinate structures when implementing Java 21's enhanced pattern matching features.
-->
<coordinate-patterns>
  <!-- Standard coordinate patterns -->
  <pattern-group name="standard">
    <coordinate>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-core</artifactId>
      <version>3.45.0</version>
    </coordinate>
    <coordinate>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-core</artifactId>
      <version>3.9.4</version>
    </coordinate>
    <coordinate>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>32.1.2-jre</version>
    </coordinate>
  </pattern-group>
  
  <!-- Complex groupId patterns with multiple segments -->
  <pattern-group name="complex-groupId">
    <coordinate>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
      <version>3.1.3</version>
    </coordinate>
    <coordinate>
      <groupId>io.quarkus.platform</groupId>
      <artifactId>quarkus-bom</artifactId>
      <version>3.3.0</version>
    </coordinate>
    <coordinate>
      <groupId>com.fasterxml.jackson.module</groupId>
      <artifactId>jackson-module-parameter-names</artifactId>
      <version>2.15.2</version>
    </coordinate>
  </pattern-group>
  
  <!-- Version range patterns -->
  <pattern-group name="version-ranges">
    <coordinate>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>[3.12.0,4.0.0)</version>
    </coordinate>
    <coordinate>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>[4.13.2]</version>
    </coordinate>
    <coordinate>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>(2.0.0,)</version>
    </coordinate>
  </pattern-group>
  
  <!-- Coordinates with classifiers and extensions -->
  <pattern-group name="classifiers-extensions">
    <coordinate>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-model</artifactId>
      <version>3.9.4</version>
      <classifier>sources</classifier>
      <extension>jar</extension>
    </coordinate>
    <coordinate>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-common</artifactId>
      <version>3.45.0</version>
      <classifier>javadoc</classifier>
      <extension>jar</extension>
    </coordinate>
    <coordinate>
      <groupId>org.apache.tomcat</groupId>
      <artifactId>tomcat</artifactId>
      <version>10.1.12</version>
      <classifier>fulldocs</classifier>
      <extension>tar.gz</extension>
    </coordinate>
  </pattern-group>
  
  <!-- SNAPSHOT version patterns -->
  <pattern-group name="snapshots">
    <coordinate>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-base</artifactId>
      <version>3.46.0-SNAPSHOT</version>
    </coordinate>
    <coordinate>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-repository-maven</artifactId>
      <version>3.46.0-20230915.172202-102</version>
    </coordinate>
    <coordinate>
      <groupId>org.apache.maven</groupId>
      <artifactId>maven-artifact</artifactId>
      <version>3.10.0-SNAPSHOT</version>
      <classifier>tests</classifier>
      <extension>jar</extension>
    </coordinate>
  </pattern-group>
  
  <!-- Special characters and edge cases -->
  <pattern-group name="special-cases">
    <coordinate>
      <groupId>com.example-hyphen</groupId>
      <artifactId>artifact_underscore</artifactId>
      <version>1.0.0.RELEASE</version>
    </coordinate>
    <coordinate>
      <groupId>org.example.123numeric</groupId>
      <artifactId>artifact-with-123</artifactId>
      <version>1.0-alpha-1</version>
    </coordinate>
    <coordinate>
      <groupId>com.example</groupId>
      <artifactId>artifact+plus</artifactId>
      <version>1.0.0+build.1</version>
    </coordinate>
  </pattern-group>
  
  <!-- Nested coordinate patterns (for testing nested record patterns) -->
  <pattern-group name="nested-patterns">
    <nested-coordinate>
      <parent>
        <groupId>org.springframework</groupId>
        <artifactId>spring-parent</artifactId>
        <version>6.0.11</version>
      </parent>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-core</artifactId>
        <version>6.0.11</version>
      </dependency>
    </nested-coordinate>
    <nested-coordinate>
      <parent>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-parent</artifactId>
        <version>39</version>
      </parent>
      <dependency>
        <groupId>org.apache.maven</groupId>
        <artifactId>maven-plugin-api</artifactId>
        <version>3.9.4</version>
      </dependency>
    </nested-coordinate>
  </pattern-group>
  
  <!-- Patterns for testing record pattern matching with inheritance -->
  <pattern-group name="inheritance-patterns">
    <base-coordinate type="jar">
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-api</artifactId>
      <version>3.45.0</version>
    </base-coordinate>
    <extended-coordinate type="jar" scope="compile">
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-plugin-api</artifactId>
      <version>3.45.0</version>
      <optional>false</optional>
    </extended-coordinate>
    <extended-coordinate type="jar" scope="test">
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>5.9.3</version>
      <optional>true</optional>
    </extended-coordinate>
  </pattern-group>
  
  <!-- Patterns for testing record pattern matching with variable component types -->
  <pattern-group name="variable-types">
    <coordinate>
      <groupId>org.example</groupId>
      <artifactId>example-artifact</artifactId>
      <version>1.0.0</version>
      <properties>
        <property name="buildNumber">12345</property>
        <property name="timestamp">20230915172202</property>
        <property name="isSnapshot">true</property>
      </properties>
    </coordinate>
    <coordinate>
      <groupId>com.example</groupId>
      <artifactId>example-lib</artifactId>
      <version>2.0.0</version>
      <properties>
        <property name="buildNumber">67890</property>
        <property name="timestamp">20230916103045</property>
        <property name="isSnapshot">false</property>
      </properties>
    </coordinate>
  </pattern-group>
</coordinate-patterns>