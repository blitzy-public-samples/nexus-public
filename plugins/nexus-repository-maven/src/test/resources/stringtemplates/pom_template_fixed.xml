<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!-- Parent POM information with String Template placeholders -->
  <parent>
    <groupId>\{parentGroupId}</groupId>
    <artifactId>\{parentArtifactId}</artifactId>
    <version>\{parentVersion}</version>
  </parent>

  <!-- Artifact coordinates with String Template placeholders -->
  <groupId>\{groupId}</groupId>
  <artifactId>\{artifactId}</artifactId>
  <version>\{version}</version>
  <packaging>\{packaging}</packaging>
  
  <name>\{name}</name>
  <description>\{description}</description>

  <!-- Properties section with String Template placeholders -->
  <properties>
    <java.version>\{javaVersion}</java.version>
    <project.build.sourceEncoding>\{encoding}</project.build.sourceEncoding>
    <maven.compiler.source>\{compilerSource}</maven.compiler.source>
    <maven.compiler.target>\{compilerTarget}</maven.compiler.target>
  </properties>

  <!-- Dependencies section with String Template placeholders -->
  <dependencies>
    <!-- Template for a dependency -->
    <dependency>
      <groupId>\{dependencyGroupId}</groupId>
      <artifactId>\{dependencyArtifactId}</artifactId>
      <version>\{dependencyVersion}</version>
      <scope>\{dependencyScope}</scope>
    </dependency>
    
    <!-- Template for multiple dependencies using String Templates -->
    \{additionalDependencies}
  </dependencies>

  <!-- Build section with String Template placeholders -->
  <build>
    <plugins>
      <plugin>
        <groupId>\{pluginGroupId}</groupId>
        <artifactId>\{pluginArtifactId}</artifactId>
        <version>\{pluginVersion}</version>
        <configuration>
          \{pluginConfiguration}
        </configuration>
      </plugin>
      
      <!-- Template for multiple plugins using String Templates -->
      \{additionalPlugins}
    </plugins>
  </build>

  <!-- Repositories section with String Template placeholders -->
  <repositories>
    <repository>
      <id>\{repositoryId}</id>
      <name>\{repositoryName}</name>
      <url>\{repositoryUrl}</url>
    </repository>
    
    <!-- Template for multiple repositories using String Templates -->
    \{additionalRepositories}
  </repositories>
</project>