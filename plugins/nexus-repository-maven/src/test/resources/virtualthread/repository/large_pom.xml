		<!-- Virtual Thread specific properties -->
		<virtual.thread.max.pool.size>256</virtual.thread.max.pool.size>
		<virtual.thread.concurrency.level>100</virtual.thread.concurrency.level>
		<virtual.thread.carrier.thread.timeout>60000</virtual.thread.carrier.thread.timeout>
		<virtual.thread.pinned.tasks>false</virtual.thread.pinned.tasks>
		<virtual.thread.stack.size>-1</virtual.thread.stack.size>
		<virtual.thread.scheduling.mode>NORMAL</virtual.thread.scheduling.mode>
		<virtual.thread.profiling.enabled>true</virtual.thread.profiling.enabled>
		<virtual.thread.monitoring.interval>1000</virtual.thread.monitoring.interval>
	</properties>

	<profiles>
		<!-- Profile for Virtual Thread testing -->
		<profile>
			<id>virtual-thread-testing</id>
			<activation>
				<jdk>21</jdk>
			</activation>
			<properties>
				<virtual.threads.enabled>true</virtual.threads.enabled>
				<maven.compiler.arg>--enable-preview</maven.compiler.arg>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<compilerArgs>
								<arg>--enable-preview</arg>
							</compilerArgs>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<argLine>--enable-preview</argLine>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile for concurrent thread testing -->
		<profile>
			<id>concurrent-thread-testing</id>
			<activation>
				<property>
					<name>concurrent.testing</name>
					<value>true</value>
				</property>
			</activation>
			<properties>
				<thread.count>100</thread.count>
				<fork.count>1C</fork.count>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<forkCount>${fork.count}</forkCount>
							<reuseForks>true</reuseForks>
							<threadCount>${thread.count}</threadCount>
							<parallel>methods</parallel>
							<perCoreThreadCount>false</perCoreThreadCount>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile for performance comparison testing -->
		<profile>
			<id>performance-comparison</id>
			<activation>
				<property>
					<name>performance.comparison</name>
				</property>
			</activation>
			<properties>
				<benchmark.iterations>10</benchmark.iterations>
				<benchmark.warmup>5</benchmark.warmup>
				<benchmark.mode>thrpt</benchmark.mode>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<benchmark.iterations>${benchmark.iterations}</benchmark.iterations>
								<benchmark.warmup>${benchmark.warmup}</benchmark.warmup>
								<benchmark.mode>${benchmark.mode}</benchmark.mode>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile for download validation - from original POM -->
		<profile>
			<id>download-validation</id>
			<properties>
				<validation.root>${maven.multiModuleProjectDirectory}/target</validation.root>
			</properties>
			<build>
				<plugins>
					<plugin>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<?m2e execute onConfiguration?>
								<id>do-download-validation</id>
								<phase>initialize</phase>
								<goals>
									<goal>unpack</goal>
								</goals>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>junit</groupId>
											<artifactId>junit</artifactId>
											<version>4.12</version>
										</artifactItem>
									</artifactItems>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Profile for Virtual Thread I/O testing -->
		<profile>
			<id>virtual-thread-io-testing</id>
			<activation>
				<property>
					<name>virtual.thread.io</name>
					<value>true</value>
				</property>
			</activation>
			<properties>
				<virtual.thread.io.enabled>true</virtual.thread.io.enabled>
				<virtual.thread.io.buffer.size>8192</virtual.thread.io.buffer.size>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<systemPropertyVariables>
								<virtual.thread.io.enabled>${virtual.thread.io.enabled}</virtual.thread.io.enabled>
								<virtual.thread.io.buffer.size>${virtual.thread.io.buffer.size}</virtual.thread.io.buffer.size>
							</systemPropertyVariables>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<plugins>
			<!-- Plugin for Virtual Thread testing -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>21</source>
					<target>21</target>
					<compilerArgs>
						<arg>--enable-preview</arg>
					</compilerArgs>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.1.2</version>
				<configuration>
					<argLine>--enable-preview</argLine>
				</configuration>
			</plugin>
		</plugins>
	</build>
