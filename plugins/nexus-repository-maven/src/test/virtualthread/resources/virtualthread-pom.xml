<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.sonatype.nexus.test.virtualthread</groupId>
  <artifactId>virtualthread-test</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Nexus Repository :: Virtual Thread Test</name>
  <description>Test POM for validating Maven repository operations with Java 21 Virtual Threads</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <!-- Enable Virtual Thread debugging -->    
    <jdk.tracePinnedThreads>true</jdk.tracePinnedThreads>
    <!-- Configure Virtual Thread scheduler parallelism if needed -->
    <!-- <jdk.virtualThreadScheduler.parallelism>16</jdk.virtualThreadScheduler.parallelism> -->
    
    <!-- Dependency versions -->
    <junit.version>5.10.0</junit.version>
    <slf4j.version>2.0.9</slf4j.version>
    <logback.version>1.4.11</logback.version>
    <jackson.version>2.15.2</jackson.version>
    <httpclient5.version>5.2.1</httpclient5.version>
  </properties>

  <dependencies>
    <!-- Core dependencies -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
    </dependency>
    
    <!-- HTTP client optimized for Virtual Threads -->
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>${httpclient5.version}</version>
    </dependency>
    
    <!-- JSON processing -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    
    <!-- Test dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Configure compiler for Java 21 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <!-- No need for --enable-preview as Virtual Threads are standard in Java 21 -->
          </compilerArgs>
        </configuration>
      </plugin>
      
      <!-- Configure surefire for testing with Virtual Threads -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.1.2</version>
        <configuration>
          <argLine>-Djdk.tracePinnedThreads</argLine>
          <systemPropertyVariables>
            <java.util.concurrent.ForkJoinPool.common.parallelism>16</java.util.concurrent.ForkJoinPool.common.parallelism>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      
      <!-- Configure JAR plugin -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
      </plugin>
      
      <!-- Configure execution plugin for running with Virtual Threads -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <mainClass>org.sonatype.nexus.test.virtualthread.VirtualThreadTest</mainClass>
          <arguments>
            <argument>--enable-virtual-threads</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
  
  <profiles>
    <!-- Profile for running with high concurrency tests -->
    <profile>
      <id>high-concurrency</id>
      <properties>
        <test.concurrency.level>10000</test.concurrency.level>
      </properties>
    </profile>
    
    <!-- Profile for running with extreme concurrency tests -->
    <profile>
      <id>extreme-concurrency</id>
      <properties>
        <test.concurrency.level>100000</test.concurrency.level>
      </properties>
    </profile>
  </profiles>
  
  <repositories>
    <!-- Repository configuration for testing proxy and group repositories -->
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <id>sonatype-snapshots</id>
      <url>https://oss.sonatype.org/content/repositories/snapshots</url>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>
</project>