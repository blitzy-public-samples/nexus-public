<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sonatype.nexus.ssl.plugin.internal.keystore.KeyStoreDAO">

  <!-- 
    Java 21 compatible schema definition with ${BINARY_TYPE} placeholder
    This placeholder is resolved at runtime based on the database in use:
    - PostgreSQL: BYTEA
    - H2, Oracle, etc.: BLOB or equivalent binary type
  -->
  <insert id="createSchema">
    CREATE TABLE IF NOT EXISTS key_store_data (
      name    VARCHAR(200)   NOT NULL,
      bytes   ${BINARY_TYPE} NOT NULL,

      CONSTRAINT pk_key_store_data_name PRIMARY KEY (name)
    );
  </insert>

  <!-- 
    Load operation optimized for Java 21 and MyBatis 3.5.15
    Uses explicit column selection instead of * for better performance
  -->
  <select id="load" resultType="KeyStoreData">
    SELECT name, bytes FROM key_store_data WHERE name = #{value};
  </select>

  <!-- 
    Default save operation for databases supporting MERGE syntax
    Compatible with Java 21 and updated JDBC drivers
  -->
  <insert id="save" parameterType="KeyStoreData">
    MERGE INTO key_store_data (name, bytes) VALUES (#{name}, #{bytes, jdbcType=BLOB});
  </insert>

  <!-- 
    PostgreSQL-specific save operation using ON CONFLICT syntax
    Optimized for PostgreSQL JDBC 42.7.2 and Java 21
    Uses explicit JDBC type for better binary data handling
  -->
  <insert id="save" parameterType="KeyStoreData" databaseId="PostgreSQL">
    INSERT INTO key_store_data (name, bytes) VALUES (#{name}, #{bytes, jdbcType=BINARY})
        ON CONFLICT (name) DO UPDATE SET bytes = #{bytes, jdbcType=BINARY};
  </insert>

  <!-- Delete operation - unchanged as it's already optimal -->
  <delete id="delete">
    DELETE FROM key_store_data WHERE name = #{value};
  </delete>

</mapper>