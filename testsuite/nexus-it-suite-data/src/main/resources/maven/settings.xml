<settings>
  <servers>
    <server>
      <id>local-nexus-admin</id>
      <username>admin</username>
      <password>admin123</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>local-nexus-admin</id>
      <mirrorOf>external:*</mirrorOf>
      <url>${proxyUrl}</url>
    </mirror>
  </mirrors>
  <profiles>
    <!-- Default development profile -->
    <profile>
      <id>development</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>http://central</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>http://central</url>
          <releases>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </releases>
          <snapshots>
            <enabled>true</enabled>
            <updatePolicy>never</updatePolicy>
          </snapshots>
        </pluginRepository>
      </pluginRepositories>
    </profile>
    
    <!-- Java 21 profile for integration tests -->
    <profile>
      <id>java21</id>
      <activation>
        <jdk>21</jdk>
      </activation>
      <properties>
        <!-- Properties for Java 21 execution -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>
        <!-- Enable preview features if needed for testing -->
        <!-- <maven.compiler.arg>--enable-preview</maven.compiler.arg> -->
        <!-- Enable virtual threads debugging if needed -->
        <!-- <jdk.tracePinnedThreads>true</jdk.tracePinnedThreads> -->
      </properties>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>development</activeProfile>
  </activeProfiles>
</settings>