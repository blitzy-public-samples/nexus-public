<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sonatype.nexus.testsuite</groupId>
    <artifactId>nexus-testsuite</artifactId>
    <version>3.77.0-08</version>
  </parent>
  
  <description>
    Provides testing utilities for validating Java 21 Virtual Thread functionality in Nexus Repository.
    Includes tools for thread pinning detection, performance comparison between platform and virtual threads,
    and specialized test support for Java 21 features.
  </description>

  <artifactId>nexus-virtual-thread-testsupport</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <packaging>bundle</packaging>

  <dependencies>
    <!--
    Dependencies provided by the Nexus container
    -->
    <dependency>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-thread</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-common</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-test-common</artifactId>
      <scope>provided</scope>
    </dependency>
    
    <dependency>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-pax-exam</artifactId>
      <scope>provided</scope>
    </dependency>
    
    <dependency>
      <groupId>org.sonatype.nexus.testsuite</groupId>
      <artifactId>nexus-repository-testsupport</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
    Dependencies that belong to this feature
    -->
    <dependency>
      <groupId>org.sonatype.goodies</groupId>
      <artifactId>goodies-testsupport</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus</groupId>
      <artifactId>nexus-testsupport</artifactId>
    </dependency>

    <!-- JUnit 5 (Jupiter) dependencies for modern test execution -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
    </dependency>
    
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
    </dependency>

    <!-- Mockito for mocking in tests -->
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
    </dependency>

    <!-- Additional testing utilities -->
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    
    <!-- Groovy dependencies for testing -->
    <dependency>
      <groupId>org.codehaus.groovy</groupId>
      <artifactId>groovy</artifactId>
      <scope>test</scope>
    </dependency>
    
    <dependency>
      <groupId>org.codehaus.groovy</groupId>
      <artifactId>groovy-test</artifactId>
      <scope>test</scope>
    </dependency>
    
    <!-- Java 21 specific dependencies -->
    <dependency>
      <groupId>org.sonatype.goodies.testsupport</groupId>
      <artifactId>goodies-testsupport-group</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-eclipse-compiler</artifactId>
            <version>3.7.0</version>
          </dependency>
          <dependency>
            <groupId>org.codehaus.groovy</groupId>
            <artifactId>groovy-eclipse-batch</artifactId>
            <version>3.0.13-02</version>
          </dependency>
        </dependencies>
        <configuration>
          <!-- Configure Java 21 compatibility for compiler plugin -->
          <source>21</source>
          <target>21</target>
          <release>21</release>
          <compilerId>groovy-eclipse-compiler</compilerId>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <configuration>
          <excludePackageNames>org.sonatype.nexus.testsuite.testsupport:org.sonatype.nexus.testsuite.testsupport.*</excludePackageNames>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.karaf.tooling</groupId>
        <artifactId>karaf-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>test-feature</id>
            <goals>
              <goal>features-generate-descriptor</goal>
            </goals>
            <configuration>
              <includeProjectArtifact>true</includeProjectArtifact>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.sisu</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <configuration>
          <instructions>
            <!-- Configure OSGi bundle packaging with appropriate Import-Package directives -->
            <Import-Package>
              org.junit.*;resolution:=optional,
              org.mockito.*;resolution:=optional,
              org.sonatype.nexus.thread.*;resolution:=optional,
              org.sonatype.nexus.common.*;resolution:=optional,
              org.sonatype.nexus.testsuite.*;resolution:=optional,
              org.sonatype.goodies.testsupport.*;resolution:=optional,
              org.awaitility.*;resolution:=optional,
              org.ops4j.pax.exam.*;resolution:=optional,
              *
            </Import-Package>
            <Export-Package>
              org.sonatype.nexus.testsuite.testsupport.virtualthread.*
            </Export-Package>
            <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>